      "core": [
        {
          "title": "电功率与额定状态",
          "text": "额定电压是正常工作设计电压，额定功率是在额定电压下的功率，实际功率由实际电压和电流决定。灯泡亮度主要与实际功率有关；相同额定电压下额定功率不同并不表示任何接法都按铭牌发光。不同工作温度下灯丝电阻改变，不能把所有实际状态都当定值电阻。"
        }
      ],
      "experiments": [
        {
          "title": "测量小灯泡电功率",
          "purpose": "在额定及不同实际电压下测功率并比较亮度。",
          "apparatus": "低压电源、标额定电压小灯泡、两表、变阻器、开关。",
          "variables": "改灯泡两端电压，记录电流和亮度，避免超额定过多。",
          "steps": [
            "断电连接电流表串联、电压表并联灯两端，变阻器最大值。",
            "缓慢调至额定电压并读电流，计算相乘功率。",
            "在安全的稍低电压下重复，比较实际功率与亮度，不盲目加压。"
          ],
          "data": "设计示例（非实测）：额定2.5 V时0.30 A，功率0.75 W；2.0 V时0.26 A，功率0.52 W。",
          "conclusion": "额定状态功率须由额定电压下的电流计算；灯丝非恒定电阻。",
          "limits": "不同电压功率不应平均成“额定功率”；本项为教材重要实验，不混称22项必做。",
          "kind": "教材重要实验"
        }
      ],
