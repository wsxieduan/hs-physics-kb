{
  "chapter": "电功和电热",
  "order": 15,
  "intro": "按苏科版2024目录整理电能表与电功、电功率、电热器与电流热效应、家庭电路安全；家用负载电流公式用于安全估算，不替代额定参数检查。",
  "points": [
    {
      "id": "power-01",
      "title": "电能表与电功",
      "level": "基础",
      "definition": "电流通过用电器时，电能可以转化为其他形式的能量。电流做的功叫电功，电功的大小与用电器两端电压、通过的电流和通电时间有关。常用电能表记录家庭用电量，千瓦时也叫度。",
      "meaning": "电功的国际单位是焦耳（J），电能表常用千瓦时（kWh）。1 kWh=3.6×10^6 J。电功公式中的电压、电流和时间必须属于同一用电过程；将小时换算成秒后可求 J，也可直接以 kW 和 h 计算 kWh。",
      "symbols": {
        "U": {
          "desc": "用电器两端电压",
          "unit": "V"
        },
        "I": {
          "desc": "通过用电器的电流",
          "unit": "A"
        },
        "t": {
          "desc": "通电时间",
          "unit": "s"
        },
        "We": {
          "desc": "电流所做的电功",
          "unit": "J"
        },
        "E_kWh": {
          "desc": "以千瓦时表示的电能",
          "unit": "kWh"
        },
        "EJ": {
          "desc": "以焦耳表示的同一电能",
          "unit": "J"
        }
      },
      "scenarios": {
        "220伏灯工作一小时": {
