          "I": 0.5,
          "t": 7200,
          "We": 792000,
          "E_kWh": 0.22,
          "EJ": 792000
        }
      },
      "formulas": [
        {
          "name": "电压电流和时间求电功",
          "expr": "We = U*I*t",
          "when": "U 用 V、I 用 A、t 用 s，算出的电功单位为 J。",
