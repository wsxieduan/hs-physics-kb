{
  "chapter": "电磁波与现代通信",
  "order": 17,
  "intro": "认识电磁波的传播、波速、频率与波长，并用传播时间估算无线通信信号在理想路径上的到达时间。",
  "points": [
    {
      "id": "emwave-03",
      "title": "信息与信息传播",
      "level": "拓展",
      "definition": "信息可以记录在文字、图像、声音等载体中，并通过声、光或电磁信号传递。现代通信常把信息转换成适合传输的信号，经过发射、传播和接收后再还原；本条中的符号速率计算是帮助理解传输过程的拓展模型。",
      "meaning": "通信过程既有信号在空间传播所需的时间，也有信息符号逐个传送所需的时间，两者不能混为一谈。下面的简单速率模型只计算在给定平均符号传送速率下传送一段信息所需的时间，不描述编码、纠错、排队或网络协议；符号速率不是电磁波载波频率，也不等同于每秒比特数。",
      "symbols": {
        "N_sym": {
          "desc": "一段信息中传送的符号总数，按个计数",
          "unit": "1"
        },
        "R_sym": {
          "desc": "平均符号传送速率，每秒传送的符号数",
          "unit": "Hz"
        },
        "t_info": {
          "desc": "传送这段符号信息所用的时间",
          "unit": "s"
        }
      },
      "scenarios": {
        "短消息传输": {
          "N_sym": 3000,
          "R_sym": 600,
          "t_info": 5
        },
        "较长消息传输": {
          "N_sym": 12000,
          "R_sym": 800,
          "t_info": 15
        }
      },
      "formulas": [
        {
          "name": "按符号速率估算传输时间",
          "expr": "N_sym = R_sym*t_info",
          "when": "拓展计算，非本卡初中必背主线。传送速率在该段时间内近似稳定；传送速率 用每秒符号数表示，传送时间 用 s。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "短消息传输",
              "expr": "R_sym*t_info",
              "ref": 3000,
              "note": "600 个符号每秒×5 s=3000 个符号。"
            },
            {
              "type": "numeric",
              "scenario": "较长消息传输",
              "expr": "R_sym*t_info",
              "ref": 12000,
              "note": "800 个符号每秒×15 s=12000 个符号。"
            },
            {
              "type": "direction",
              "scenario": "短消息传输",
              "var": "t_info",
              "lo": 0,
              "hi": 100,
              "expr": "R_sym*t_info",
              "expect": "up",
              "note": "传送速率固定时，传送时间越长，传送的符号数越多。"
            },
            {
              "type": "scan",
              "scenario": "短消息传输",
              "var": "t_info",
              "lo": 0,
              "hi": 10000,
              "note": "扫描非负时间，符号数量估算保持有限。"
            },
            {
              "type": "consistency",
              "scenario": "短消息传输",
              "with": "emwave-03|按符号速率估算传输时间",
              "with_expr": "N_sym",
              "target": "一段信息中传送的符号总数，按个计数",
              "note": "直接求本公式输出，与情境中另列的N_sym设计基准核对；数据是设计示例，不是实测。用于核对定义、反算或边界值，不宣称不同物理原理互证。",
              "verification_kind": "独立设计情境数据核对"
            },
            {
              "type": "numeric",
              "scenario": "短消息传输",
              "ref": 3000,
              "rtol": 1e-10,
              "atol": 0,
              "note": "设计示例；人工标签保留的指定反例正确控制。每秒600个符号持续5 s总量3000个；只拿600每秒速率充当总量，被目标量纲门禁拒绝。"
            }
          ]
        },
        {
          "name": "由符号数和时间求平均传送速率",
          "expr": "R_sym = N_sym/t_info",
          "when": "拓展计算，非本卡初中必背主线。符号总数和传送时间对应同一段传输，传送时间 大于 0。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "短消息传输",
              "expr": "N_sym/t_info",
              "ref": 600,
              "note": "3000 个符号÷5 s=600 个符号每秒。"
            },
            {
              "type": "numeric",
              "scenario": "较长消息传输",
              "expr": "N_sym/t_info",
              "ref": 800,
              "note": "12000 个符号÷15 s=800 个符号每秒。"
            },
            {
              "type": "direction",
              "scenario": "短消息传输",
              "var": "N_sym",
              "lo": 0,
              "hi": 100000,
              "expr": "N_sym/t_info",
              "expect": "up",
              "note": "传送时间固定时，符号总数越多，平均传送速率越大。"
            },
            {
              "type": "scan",
              "scenario": "短消息传输",
              "var": "t_info",
              "lo": 0.1,
              "hi": 10000,
              "note": "扫描正传送时间，速率计算不除以零。"
            }
          ]
        }
      ],
      "derivation": [
        "信息先被记录或编码成可以传送的信号。",
        "信号需要经过发射、传播和接收，接收端再从信号中还原信息。",
        "若用平均符号速率描述一段稳定传输，符号总数等于每秒符号数乘以时间。",
        "此拓展模型只算符号传送时间；真实通信还会受编码、纠错、设备处理和网络排队影响。"
      ],
      "errors": [
        {
          "wrong": "把每秒传送的符号数误当成整段信息的符号总数。",
          "why": "符号总数还要乘以传送时间；只写每秒速率会漏掉时间因素，题目问总量时尤其要注意。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          },
          "automation_review": {
            "status": "指定反例已补验；原人工审核标签保留",
            "basis": "每秒600个符号持续5 s总量3000个；只拿600每秒速率充当总量，被目标量纲门禁拒绝。",
            "scenario": "短消息传输",
            "correct_expression": "N_sym = R_sym*t_info",
            "wrong_expression": "R_sym",
            "correct_value": 3000,
            "wrong_value": 600,
            "unit": "1",
            "wrong_status": "dimension_conflict",
            "note": "这是原创设计反例，机器仅验证指定模型、数据及量纲；自然语言命题、学生认知与装置仍待教师确认。"
          }
        },
        {
          "wrong": "把传送 5 s 当成 5 ms，再把符号总数少算 1000 倍。",
          "wrong_expr": "N_sym = R_sym*(t_info/1000)",
          "why": "情境时间已经用秒表示，不能再次按毫秒缩小；重复换算会让估算结果少 1000 倍。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "短消息传输",
            "expr": "R_sym*(t_info/1000)",
            "ref": 3000
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "把符号传送速率等同于电磁波载波频率或每秒比特数。",
          "why": "符号速率、载波频率和比特率的定义不同；没有调制和编码信息时，不能把三者数值直接等同。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "一个简化通信模型中，平均每秒传送 600 个符号，传送 5 s，估算传过的符号总数。",
        "solution": [
          "N_sym=R_sym*t_info=600×5=3000 个符号。",
          "这是符号数的拓展估算，不代表网络端到端时延或比特率。"
        ],
        "answer": "约传送 3000 个符号。"
      },
      "prereq": [
        "motion-01",
        "emwave-01"
      ],
      "next": [
        "emwave-02"
      ],
      "tags": [
