        "信息传播",
        "通信信号",
        "符号速率",
        "拓展模型"
      ],
      "core": [
        {
          "title": "信息与信息传播",
          "text": "信息借声音、文字、图像等载体记录，通信可把信息转为信号，经发送、传输和接收还原。模拟信号连续变化，数字信号用离散状态表示；两者不是“快慢”同义词。数据符号率和电磁波频率定义不同，数字信号也可借电磁波传输。"
        },
        {
          "title": "本章素养回顾（原创任务）",
          "text": "选择本章一个现象，写出结论、成立条件和证据；用另一条本章规律复核解释是否矛盾。指出一次测量或模型的局限，并说明还需什么证据；数值通过不替代概念辨析。"
        }
      ],
      "learning_scope": "初中主线；公式含拓展"
    },
    {
      "id": "emwave-01",
      "title": "电磁波的波速、频率和波长",
      "level": "基础",
      "definition": "电磁波能够在真空中传播，真空中的传播速度约为 3.0×10^8 m/s。电磁波的波速等于波长与频率的乘积；在同一真空中波速近似固定，频率越高，波长越短。",
      "meaning": "无线电波、微波、红外线、可见光、紫外线、X 射线和伽马射线都属于电磁波，主要差别包括频率和波长范围。电磁波不需要空气等介质才能传播。使用波速关系时，波长用 m、频率用 Hz，所得波速为 m/s；空气中传播速度可近似按真空光速处理。",
      "symbols": {
        "c": {
          "desc": "电磁波在真空中的传播速度近似值",
          "unit": "m/s"
        },
        "lambda": {
          "desc": "电磁波波长",
          "unit": "m"
        },
        "f": {
          "desc": "电磁波频率",
          "unit": "Hz"
        },
        "d": {
          "desc": "电磁波传播距离",
          "unit": "m"
        },
        "t": {
          "desc": "理想传播所用时间",
          "unit": "s"
        }
      },
      "scenarios": {
        "无线电波": {
          "c": 300000000,
          "lambda": 3,
          "f": 100000000
        },
        "微波": {
          "c": 300000000,
          "lambda": 0.5,
          "f": 600000000
        },
        "传播3千米": {
          "d": 3000,
          "c": 300000000,
          "t": 1e-05
        },
        "传播30千米": {
          "d": 30000,
          "c": 300000000,
          "t": 0.0001
        }
      },
      "formulas": [
        {
          "name": "波速等于波长乘频率",
          "expr": "c = lambda*f",
          "when": "波长 lambda 用 m、频率 f 用 Hz，c 用 m/s；真空波速取约 3.0×10^8 m/s。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "无线电波",
              "expr": "lambda*f",
              "ref": 300000000,
              "note": "3 m×100 000 000 Hz=3.0×10^8 m/s。"
            },
            {
              "type": "numeric",
              "scenario": "微波",
              "expr": "lambda*f",
              "ref": 300000000,
              "note": "0.5 m×600 000 000 Hz=3.0×10^8 m/s。"
            },
            {
              "type": "scan",
              "scenario": "无线电波",
              "var": "f",
              "lo": 1,
              "hi": 10000000000,
              "note": "扫描正频率范围，波速乘积计算保持有限。"
            },
            {
              "type": "consistency",
              "scenario": "无线电波",
              "with": "emwave-01|波速等于波长乘频率",
              "with_expr": "c",
              "target": "电磁波在真空中的传播速度近似值",
              "note": "直接求本公式输出，与情境中另列的c设计基准核对；数据是设计示例，不是实测。用于核对定义、反算或边界值，不宣称不同物理原理互证。",
              "verification_kind": "独立设计情境数据核对"
            }
          ]
        },
        {
          "name": "由波速和频率求波长",
          "expr": "lambda = c/f",
          "when": "电磁波在真空或近似真空的空气中传播，f 不为零。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "无线电波",
              "expr": "c/f",
              "ref": 3,
              "note": "3.0×10^8 m/s÷100 000 000 Hz=3 m。"
            },
            {
              "type": "numeric",
              "scenario": "微波",
              "expr": "c/f",
              "ref": 0.5,
              "note": "3.0×10^8÷600 000 000=0.5 m。"
            },
            {
              "type": "direction",
              "scenario": "无线电波",
              "var": "f",
              "lo": 1000000,
              "hi": 1000000000,
              "expr": "c/f",
              "expect": "down",
              "note": "波速固定时，频率增大，波长减小。"
            },
            {
              "type": "scan",
              "scenario": "无线电波",
              "var": "f",
              "lo": 1,
              "hi": 10000000000,
              "note": "扫描正频率，反算波长不除以零。"
            }
          ]
        }
      ],
      "derivation": [
        "电磁波每秒传播一定距离，该距离为波速 c。",
        "波长 lambda 表示相邻同相位点之间的距离，频率 f 表示每秒振动次数。",
        "每秒前进的完整波长数乘以波长，得到 c=lambda*f。",
        "同一真空中 c 近似不变，所以频率越高波长越短。"
      ],
      "errors": [
        {
          "wrong": "把波长与频率相乘写成频率除以波长。",
          "wrong_expr": "c = f/lambda",
          "why": "波速关系为波长乘频率；f/lambda 的单位不是 m/s。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "kind": "dimension",
            "target": "c = f/lambda",
            "lhs_dim": "L·T^-1",
            "rhs_dim": "L^-1·T^-1",
            "expect": "mismatch",
            "note": "实际量纲检查得到等号左边为L·T^-1、右边为L^-1·T^-1；两边不是同一物理量，因此该等式不成立。"
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "频率已用 Hz 代入后，又按 MHz 再除以 1 000 000，造成波速少算百万倍。",
          "wrong_expr": "c = lambda*f/1000000",
          "why": "情境中的 100 000 000 已是 Hz；与 3 m 相乘应得到 3.0×10^8 m/s，不应重复换算。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "无线电波",
            "expr": "lambda*f/1000000",
            "ref": 300000000
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "认为电磁波传播必须依赖空气或其他介质。",
          "why": "电磁波能够在真空中传播；声波需要介质，两类波的传播条件不同。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "某无线电波频率100 MHz，在真空中传播，取真空光速3.0×10⁸ m/s，求波长。",
        "solution": [
          "100 MHz=100 000 000 Hz。",
          "lambda=c/f=3.0×10^8/100 000 000=3 m。"
        ],
        "answer": "波长约为 3 m。"
      },
      "prereq": [
