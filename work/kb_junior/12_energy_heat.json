        "solution": [
          "Q=c_h*m*dT。",
          "Q=4200×0.5×10=21 000 J。"
        ],
        "answer": "水吸收 21 000 J 热量。"
      },
      "prereq": [
        "state-01"
      ],
      "next": [],
      "tags": [
        "比热容",
