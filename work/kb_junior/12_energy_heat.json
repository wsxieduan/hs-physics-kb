{
  "chapter": "机械能和内能",
  "order": 12,
  "intro": "按苏科版2024目录分为机械能、内能与热传递、物质比热容、机械能和内能相互转化；能量平衡均注明系统边界和散热条件。",
  "points": [
    {
      "id": "energy-01",
      "title": "机械能",
      "level": "基础",
      "definition": "动能是物体因运动具有的能量，势能包括重力势能和弹性势能；动能与势能统称机械能。被举高的物体具有重力势能，发生弹性形变的物体具有弹性势能；比较大小必须控制相关条件，初中以实验和定性规律为主。",
      "meaning": "质量相同时速度越大，动能越大；速度相同时质量越大，动能越大。相对同一参考面，质量相同时高度越高，重力势能越大；高度相同时质量越大，重力势能越大。同一弹性物体在弹性限度内，形变量越大，弹性势能一般越大。机械能可在不同形式间转化，有摩擦等耗散时机械能可能减少，但总能量不消失。",
      "symbols": {
        "m": {
          "desc": "物体质量",
          "unit": "kg"
        },
        "v": {
          "desc": "物体速度大小",
          "unit": "m/s"
        },
        "Ek": {
          "desc": "物体动能",
          "unit": "J"
        },
        "g": {
          "desc": "当地重力加速度",
          "unit": "N/kg"
        },
        "h": {
          "desc": "相对选定参考面的高度",
          "unit": "m"
        },
        "Ep": {
          "desc": "物体重力势能",
          "unit": "J"
        },
        "Em": {
          "desc": "动能、重力势能与弹性势能的总和",
          "unit": "J"
        },
        "Q": {
          "desc": "物体吸收的热量",
          "unit": "J"
        },
        "c_h": {
          "desc": "物质比热容",
          "unit": "J/kg/℃"
        },
        "dT": {
          "desc": "物体升高的温度",
          "unit": "℃"
        },
        "Ee": {
          "desc": "弹性势能，本卡只用已知储能作账目",
          "unit": "J"
        }
      },
      "scenarios": {
        "高处小球": {
          "m": 2,
          "v": 3,
          "Ek": 9,
          "g": 10,
          "h": 5,
          "Ep": 100,
          "Em": 109,
          "Ee": 0
        },
        "抛起物体": {
          "m": 1,
          "v": 4,
          "Ek": 8,
          "g": 10,
          "h": 3,
          "Ep": 30,
          "Em": 38,
          "Ee": 0
        },
        "半千克水升温10度": {
          "Q": 21000,
          "c_h": 4200,
          "m": 0.5,
          "dT": 10,
          "Ee": 0
        },
        "两百克水升温5度": {
          "Q": 4200,
          "c_h": 4200,
          "m": 0.2,
          "dT": 5,
          "Ee": 0
        },
        "弹性储能账目": {
          "Ek": 2,
          "Ep": 3,
          "Ee": 5,
          "Em": 10
        }
      },
      "formulas": [
        {
          "name": "物体动能",
          "expr": "Ek = 0.5*m*v^2",
          "when": "拓展计算，非本卡初中必背主线。适用于物体平动的动能计算，m 用 kg、v 用 m/s。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "高处小球",
              "expr": "0.5*m*v^2",
              "ref": 9,
              "note": "0.5×2×3^2=9 J。"
            },
            {
              "type": "numeric",
              "scenario": "抛起物体",
              "expr": "0.5*m*v^2",
              "ref": 8,
              "note": "0.5×1×4^2=8 J。"
            },
            {
              "type": "direction",
              "scenario": "高处小球",
              "var": "v",
              "lo": 0,
              "hi": 20,
              "expr": "0.5*m*v^2",
              "expect": "up",
              "note": "质量固定时，速度增大，动能按速度平方增大。"
            },
            {
              "type": "scan",
              "scenario": "高处小球",
              "var": "v",
              "lo": 0,
              "hi": 100,
              "note": "扫描非负速度，动能保持非负且有限。"
            }
          ]
        },
        {
          "name": "物体重力势能",
          "expr": "Ep = m*g*h",
          "when": "拓展计算，非本卡初中必背主线。h 从选定参考面竖直量起，g 取当地值。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "高处小球",
              "expr": "m*g*h",
              "ref": 100,
              "note": "2 kg×10 N/kg×5 m=100 J。"
            },
            {
              "type": "numeric",
              "scenario": "抛起物体",
              "expr": "m*g*h",
              "ref": 30,
              "note": "1 kg×10 N/kg×3 m=30 J。"
            },
            {
              "type": "direction",
              "scenario": "高处小球",
              "var": "h",
              "lo": 0,
              "hi": 20,
              "expr": "m*g*h",
              "expect": "up",
              "note": "质量和 g 固定时，高度增大，重力势能增大。"
            },
            {
              "type": "scan",
              "scenario": "高处小球",
              "var": "h",
              "lo": 0,
              "hi": 100,
              "note": "扫描参考面以上的非负高度。"
            }
          ]
        },
        {
          "name": "动能与各类势能组成机械能",
          "expr": "Em = Ek+Ep+Ee",
          "when": "机械能账目包含动能、重力势能和弹性势能；参考面一致，其他机械储能另计。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "高处小球",
              "expr": "Ek+Ep",
              "ref": 109,
              "note": "9 J+100 J=109 J。"
            },
            {
              "type": "numeric",
              "scenario": "抛起物体",
              "expr": "Ek+Ep",
              "ref": 38,
              "note": "8 J+30 J=38 J。"
            },
            {
              "type": "scan",
              "scenario": "高处小球",
              "var": "Ek",
              "lo": 0,
              "hi": 10000,
              "note": "扫描非负动能，机械能总量有限。"
            },
            {
              "type": "numeric",
              "scenario": "弹性储能账目",
              "ref": 10,
              "note": "独立加和2 J运动能、3 J重力储能、5 J弹性储能，总10 J；不能漏掉弹性项。"
            }
          ]
        },
        {
          "name": "由速度和高度直接求机械能",
          "expr": "Em = 0.5*m*v^2+m*g*h",
          "when": "拓展计算，非本卡初中必背主线。同一物体相对同一参考面计重力势能，机械能只包含动能和重力势能。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "高处小球",
              "expr": "0.5*m*v^2+m*g*h",
              "ref": 109,
              "note": "直接代入质量、速度和高度，得到 9 J+100 J=109 J。"
            },
            {
              "type": "numeric",
              "scenario": "抛起物体",
              "expr": "0.5*m*v^2+m*g*h",
              "ref": 38,
              "note": "直接代入得 8 J+30 J=38 J，与该情境机械能相符。"
            },
            {
              "type": "direction",
              "scenario": "高处小球",
              "var": "h",
              "lo": 0,
              "hi": 20,
              "expr": "0.5*m*v^2+m*g*h",
              "expect": "up",
              "note": "速度不变、参考面固定时，升高物体会增加重力势能和机械能。"
            },
            {
              "type": "scan",
              "scenario": "高处小球",
              "var": "h",
              "lo": 0,
              "hi": 100,
              "note": "扫描参考面以上高度，直接计算的机械能保持有限。"
            },
            {
              "type": "consistency",
              "scenario": "高处小球",
              "with": "energy-01|由速度和高度直接求机械能",
              "with_expr": "Ek+Ep",
              "target": "动能、重力势能与弹性势能的总和",
              "note": "本公式直接求Em；参考端显式关系为Ek+Ep。两端使用同一情境和阶段，只核对该关系；with字段仅定位来源，不代表调用另一条被覆盖的公式。",
              "verification_kind": "独立关系核对"
            }
          ]
        }
      ],
      "derivation": [
        "物体运动时具有动能，计算时使用质量和速度。",
        "相对参考面被举高的物体具有重力势能，计算时使用质量、g 和高度。",
        "把动能与重力势能相加，得到该参考面下的机械能。",
        "分析能量转化时，检查摩擦等因素是否使机械能转化为内能。"
      ],
      "errors": [
        {
          "wrong": "把动能写成质量与速度的一次方相乘，漏掉速度平方和二分之一。",
          "wrong_expr": "Ek = m*v",
          "why": "动能的单位应为 J，m*v 的单位是 kg·m/s；量纲与数值关系都不符。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "scenario": "高处小球",
            "expr": "m*v",
            "ref": 9
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "写动能公式时漏掉系数二分之一，只保留质量乘速度平方。",
          "wrong_expr": "Ek = m*v^2",
          "why": "高处小球的动能为 0.5×2×3^2=9 J；漏掉二分之一会得到 18 J，量纲仍正确但数值翻倍。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "高处小球",
            "expr": "m*v^2",
            "ref": 9
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "认为物体高度变化时重力势能与参考面无关。",
          "why": "重力势能数值依赖所选零势能参考面；比较同一过程能量变化时要保持参考面一致。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "用同一小车从同一斜面不同高度静止释放，撞击同一木块。高处释放时木块被推得更远。解释能量变化，再说明怎样比较质量对动能的影响。",
        "solution": [
          "高处释放的小车初始重力势能更大，下滑时部分转成动能，撞击后对木块做功，推动距离可作为比较证据。",
          "研究质量时应改变小车质量、保持撞击前速度相同并保持木块和水平面相同；不能同时任意改变质量和速度。"
        ],
        "answer": "能量可由重力势能转为动能再转移；质量比较须控制速度相同。"
      },
      "prereq": [
        "motion-01",
        "force-01"
      ],
      "next": [
        "energy-02"
      ],
      "tags": [
        "机械能",
        "动能",
        "重力势能",
        "机械能转化"
      ],
      "core": [
        {
          "title": "初中核心：三种机械能",
          "text": "运动小车推动木块的距离用于比较动能；从不同高度释放同一物体，或同一高度释放不同质量物体，用做功效果比较重力势能。保持材料相同再比较弹性形变量，以弹簧推动物体的效果比较弹性势能。控制变量和能量转化是主线，不要求推导动能平方公式或弹性势能公式。弹性势能不是重力势能，机械能不能一概只算动能与重力势能。"
        },
        {
          "title": "机械能转化与拓展边界",
          "text": "摆球下落时重力势能减小、动能增大，上升时相反；弹簧恢复形变可把弹性势能转为动能。忽略摩擦和其他耗散且系统边界适当时，机械能可守恒。下面数值关系供高中衔接；动能和重力势能公式不当作初中必背，机械能加和若忽略弹性势能必须明确无弹性储能。"
        },
        {
          "title": "本章素养回顾（原创任务）",
          "text": "选择本章一个现象，写出结论、成立条件和证据；用另一条本章规律复核解释是否矛盾。指出一次测量或模型的局限，并说明还需什么证据；数值通过不替代概念辨析。"
        }
      ],
      "experiments": [
        {
          "title": "比较动能与重力势能的影响因素",
          "purpose": "用做功效果作间接证据，练习控制变量。",
          "apparatus": "小车、缓斜面、不同配重、木块、刻度尺。",
          "variables": "动能比较固定质量改变撞击速度，或固定速度改变质量；重力势能比较固定质量改变高度。",
          "steps": [
            "同车从不同高度释放，记录撞后木块移动距离。",
            "研究质量时通过速度测量等办法保持撞击速度相同，再换配重。",
            "写清间接指标、控制条件和适用范围，再说明能量转化。"
          ],
          "data": "设计示例（非实测）：同车较高位置释放推动距离可由5 cm增至9 cm；这些是设计示例，不由距离直接读出多少J。",
          "conclusion": "动能随质量和速度增大而增大；重力势能随质量和相对高度增大而增大，控制变量后分别判断。",
          "limits": "摩擦差异、撞击方式和速度未控制会混入影响，不能由两组距离推导动能平方系数。",
          "kind": "教材与目录补充"
        }
      ],
      "learning_scope": "初中主线；公式含拓展"
    },
    {
      "id": "energy-03",
      "title": "内能 热传递",
      "level": "基础",
      "definition": "物体内部所有分子无规则运动的动能及分子相互作用势能的总和称为内能。热传递是内能改变的一种方式，能量从温度较高的物体传向温度较低的物体，直到达到热平衡。",
      "meaning": "热量是热传递过程中传递的能量，不是物体“含有”的一种物质。忽略与外界的能量交换和散失时，高温物体放出的热量等于低温物体吸收的热量；实际实验需要考虑容器、温度计和环境带走的能量。用水的比热容可估算吸热量，再与热平衡的能量账目核对。",
      "symbols": {
        "Q_lost": {
          "desc": "高温物体放出的热量大小",
          "unit": "J"
        },
        "Q_gained": {
          "desc": "低温物体吸收的热量",
          "unit": "J"
        },
        "c_h": {
          "desc": "被加热物质的比热容",
          "unit": "J/kg/℃"
        },
        "m": {
          "desc": "被加热物质质量",
          "unit": "kg"
        },
        "dT": {
          "desc": "被加热物质的温升",
          "unit": "℃"
        }
      },
      "scenarios": {
        "水吸热与热水放热": {
          "Q_lost": 42000,
          "Q_gained": 42000,
          "c_h": 4200,
          "m": 0.2,
          "dT": 50
        },
        "混合水热交换": {
          "Q_lost": 84000,
          "Q_gained": 84000,
          "c_h": 4200,
          "m": 0.4,
          "dT": 50
        }
      },
      "formulas": [
        {
          "name": "绝热热交换中的放热吸热平衡",
          "expr": "Q_lost = Q_gained",
          "when": "把参与热交换的物体作为近似绝热系统，忽略向环境、容器等散失的能量。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "水吸热与热水放热",
              "expr": "Q_gained",
              "ref": 42000,
              "note": "近似绝热时，热水放出 42 000 J，冷水吸收相同热量。 "
            },
            {
              "type": "numeric",
              "scenario": "混合水热交换",
              "expr": "Q_gained",
              "ref": 84000,
              "note": "另一组热平衡情境中放热量和吸热量相同。 "
            },
            {
              "type": "direction",
              "scenario": "水吸热与热水放热",
              "var": "Q_lost",
              "lo": 0,
              "hi": 200000,
              "expr": "Q_lost",
              "expect": "up",
              "note": "理想热平衡情境中放热量增加，吸热量按能量平衡同步增加。 "
            },
            {
              "type": "scan",
              "scenario": "水吸热与热水放热",
              "var": "Q_lost",
              "lo": 0,
              "hi": 1000000,
              "note": "扫描非负热量，守恒关系保持有限。 "
            },
            {
              "type": "consistency",
              "scenario": "水吸热与热水放热",
              "with": "energy-03|绝热热交换中的放热吸热平衡",
              "with_expr": "c_h*m*dT",
              "target": "高温物体放出的热量大小",
              "note": "本公式直接求Q_lost；参考端显式关系为c_h*m*dT。两端使用同一情境和阶段，只核对该关系；with字段仅定位来源，不代表调用另一条被覆盖的公式。",
              "verification_kind": "独立关系核对"
            }
          ]
        }
      ],
      "derivation": [
        "确定热交换系统边界，并判断是否可近似忽略向环境散热。",
        "记录高温物体放热量和低温物体吸热量的大小。",
        "在近似绝热的系统内，两者大小相等；实际实验可将差值视作热损失与测量误差分析。"
      ],
      "errors": [
        {
          "wrong": "在忽略散热的热平衡问题中把吸热量误写成放热量的两倍。",
          "wrong_expr": "Q_lost = 2*Q_gained",
          "why": "封闭近似绝热系统的能量账目应相等；额外乘 2 会破坏热量平衡。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "水吸热与热水放热",
            "expr": "2*Q_gained",
            "ref": 42000
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "认为热量是物体本身储存的一种物质。",
          "why": "热量描述热传递过程中转移的能量；物体具有内能，而不是“含有热量”。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "忽略散热时，一块热金属放出 600 J 热量给水，水吸收多少热量？",
        "solution": [
          "把金属和水作为近似绝热系统。",
          "金属放出的热量等于水吸收的热量。"
        ],
        "answer": "水吸收约 600 J。"
      },
      "prereq": [
        "energy-01"
      ],
      "next": [
        "energy-02",
        "energy-04"
      ],
      "tags": [
        "内能",
        "热传递",
        "吸热",
        "放热",
        "热平衡"
      ],
      "core": [
        {
          "title": "内能、温度和热量",
          "text": "内能是物体内大量微观粒子无规则运动的动能及相互作用势能的总和，所有物体都有内能，0℃并不代表没有内能。温度描述冷热，内能还与物体质量、状态等有关，不能只比温度判内能多少。热量是热传递过程中转移的能量，用J；只说“物体内能增大”，不说“物体含有热量”。热传递自发地由高温物体向低温物体发生。"
        }
      ],
      "learning_scope": "初中"
    },
    {
      "id": "energy-02",
      "title": "物质的比热容",
      "level": "基础",
      "definition": "比热容表示单位质量的某种物质温度升高或降低 1℃ 时吸收或放出的热量。不同物质的比热容通常不同；同种物质吸收热量还与质量和温度变化有关。",
      "meaning": "水的比热容约为 4200 J/kg/℃，表示 1 kg 水升高 1℃ 约需吸收 4200 J。用 Q=c_h*m*dT 计算时，先确认过程没有发生物态变化，并把质量、温升和热量单位统一。比热容是物质特性，不等于一整份物体吸收的热量。",
      "symbols": {
        "Q": {
          "desc": "物体吸收的热量",
          "unit": "J"
        },
        "c_h": {
          "desc": "物质比热容",
          "unit": "J/kg/℃"
        },
        "m": {
          "desc": "物体质量",
          "unit": "kg"
        },
        "dT": {
          "desc": "物体升高的温度",
          "unit": "℃"
        }
      },
      "scenarios": {
        "半千克水升温10度": {
          "Q": 21000,
          "c_h": 4200,
          "m": 0.5,
          "dT": 10
        },
        "两百克水升温5度": {
          "Q": 4200,
          "c_h": 4200,
          "m": 0.2,
          "dT": 5
        }
      },
      "formulas": [
        {
          "name": "加热温度变化时的吸热量",
          "expr": "Q = c_h*m*dT",
          "when": "无物态变化、比热容近似不变，dT 为温升，单位 ℃。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "半千克水升温10度",
              "expr": "c_h*m*dT",
              "ref": 21000,
              "note": "4200×0.5×10=21 000 J。"
            },
            {
              "type": "numeric",
              "scenario": "两百克水升温5度",
              "expr": "c_h*m*dT",
              "ref": 4200,
              "note": "4200×0.2×5=4 200 J。"
