            {
              "type": "numeric",
              "scenario": "两百克水升温5度",
              "expr": "Q/(m*dT)",
              "ref": 4200,
              "note": "4 200÷(0.2×5)=4200 J/kg/℃。"
            },
            {
              "type": "scan",
              "scenario": "半千克水升温10度",
              "var": "m",
              "lo": 0.01,
              "hi": 10,
              "note": "扫描正质量，反算比热容避免除零。"
            }
          ]
