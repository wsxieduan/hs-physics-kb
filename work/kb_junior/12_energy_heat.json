            {
              "type": "scan",
              "scenario": "半千克水升温10度",
              "var": "dT",
              "lo": 0,
              "hi": 100,
              "note": "扫描非负温升，吸热量计算保持线性。"
            },
            {
              "type": "consistency",
              "scenario": "半千克水升温10度",
              "with": "energy-02|加热温度变化时的吸热量",
              "with_expr": "Q",
              "target": "物体吸收的热量",
              "note": "直接求本公式输出，与情境中另列的Q设计基准核对；数据是设计示例，不是实测。用于核对定义、反算或边界值，不宣称不同物理原理互证。",
              "verification_kind": "独立设计情境数据核对"
            }
          ]
        },
        {
          "name": "由吸热量求比热容",
          "expr": "c_h = Q/(m*dT)",
          "when": "样品无物态变化，吸收热量 Q、质量 m 和温升 dT 已知。",
