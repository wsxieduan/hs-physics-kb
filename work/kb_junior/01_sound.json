{
  "chapter": "引言 · 第一章 声现象",
  "order": 1,
  "intro": "从发声物体的振动出发，认识声音怎样传播、怎样被听见，以及声速、回声和频率如何用于测量。噪声控制、音色等定性内容依据实验现象辨析，不把它们伪装成定量定律。",
  "points": [
    {
      "id": "sound-01",
      "title": "声音的产生、传播与声速",
      "level": "基础",
      "definition": "声音由物体的振动产生，传播需要介质，在不同介质中的传播快慢不同。已知声音通过的路程和所用时间，可以用路程与时间的比值求声速；这一计算只描述可测量的传播过程，不代替对发声和介质条件的实验判断。",
      "meaning": "观察声源时，可以用纸屑、薄膜或触摸等方式发现振动；传播时，声音通过固体、液体或气体中的介质传到接收者，真空中不能传播声音。声速把传播路程和时间联系起来；空气温度改变时声速也会变化，因此实验比较要注明条件。控制噪声可在声源处减弱振动，在传播途中隔声或吸声，也可在接收者处使用耳塞等防护。噪声控制不能简单理解成降低声速。",
      "symbols": {
        "s": {
          "desc": "声音在介质中传播的路程",
          "unit": "m"
        },
        "t": {
          "desc": "声音传播这段路程所用的时间",
          "unit": "s"
        },
        "c": {
          "desc": "声速，以米每秒表示",
          "unit": "m/s"
        },
        "v": {
          "desc": "同一声速换算成千米每小时后的数值",
          "unit": "km/h"
        },
        "d": {
          "desc": "声源到反射面的单程距离，用于另一种测声速方法",
          "unit": "m"
        },
        "t_e": {
          "desc": "声音发出到接收到回声的往返时间",
          "unit": "s"
        },
        "f": {
          "desc": "声源振动频率，即每秒完成的振动次数",
          "unit": "Hz"
        },
        "T": {
          "desc": "声源完成一次完整振动所用的周期",
          "unit": "s"
        },
        "N": {
          "desc": "在计时区间内完成的完整振动次数",
          "unit": "1"
        }
      },
      "scenarios": {
        "近距离直达测量": {
          "s": 34,
          "t": 0.1,
          "c": 340,
          "v": 1224,
          "d": 68,
          "t_e": 0.4
        },
        "较远直达测量": {
          "s": 170,
          "t": 0.5,
          "c": 340,
          "v": 1224,
          "d": 34,
          "t_e": 0.2
        },
        "0℃附近空气示例": {
          "s": 33,
          "t": 0.1,
          "c": 330,
          "v": 1188,
          "d": 68,
          "t_e": 0.4
        },
        "低音演示": {
          "f": 200,
          "T": 0.005,
          "N": 400,
          "t": 2
        },
        "较高音演示": {
          "f": 500,
          "T": 0.002,
          "N": 1000,
          "t": 2
        },
        "次声示例": {
          "f": 15,
          "T": 0.0666666666667,
          "N": 15,
          "t": 1
        },
        "超声示例": {
          "f": 30000,
          "T": 3.33333333333e-05,
          "N": 30000,
          "t": 1
        }
      },
      "formulas": [
        {
          "name": "由直达传播路程和时间测声速",
          "expr": "c = s/t",
          "when": "传播路程和时间采用同一段直达传播过程，结果单位为 m/s。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "近距离直达测量",
              "expr": "s/t",
              "ref": 340,
              "note": "34 m ÷ 0.1 s = 340 m/s，独立计算后录入参考值。"
            },
            {
              "type": "numeric",
              "scenario": "较远直达测量",
              "expr": "s/t",
              "ref": 340,
              "note": "170 m ÷ 0.5 s = 340 m/s，改变测量路程和时间后复算。"
            },
            {
              "type": "direction",
              "scenario": "近距离直达测量",
              "var": "s",
              "lo": 17,
              "hi": 68,
              "expr": "s/t",
              "expect": "up",
              "note": "传播时间不变时，测得路程增大，按定义算出的速度增大。"
            },
            {
              "type": "scan",
              "scenario": "近距离直达测量",
              "var": "t",
              "lo": 0.02,
              "hi": 2,
              "note": "固定一组有限路程，检查正时间范围内计算不出现异常值。"
            },
            {
              "type": "consistency",
              "scenario": "近距离直达测量",
              "with": "sound-01|由直达传播路程和时间测声速",
              "with_expr": "2*d/t_e",
              "target": "声速，以米每秒表示",
              "note": "本公式直接求c；参考端显式关系为2*d/t_e。两端使用同一情境和阶段，只核对该关系；with字段仅定位来源，不代表调用另一条被覆盖的公式。",
              "verification_kind": "独立关系核对"
            },
            {
              "type": "compare",
              "scenario": "近距离直达测量",
              "expr": "c",
              "op": ">",
              "vs": "100",
              "note": "本情境的空气声速为数百 m/s，不应落到个位数。"
            },
            {
              "type": "compare",
              "scenario": "近距离直达测量",
              "expr": "c",
              "op": "<",
              "vs": "1000",
              "note": "本情境声速数量级为数百 m/s，而非数千 m/s。"
            }
          ]
        },
        {
          "name": "米每秒与千米每小时的换算",
          "expr": "v = 3.6*c",
          "when": "c 用 m/s 表示、v 用 km/h 表示时，1 m/s = 3.6 km/h。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "近距离直达测量",
              "expr": "3.6*c",
              "ref": 1224,
              "note": "340 m/s × 3.6 = 1224 km/h；先把 1 m 换为 0.001 km、1 s 换为 1/3600 h。"
            },
            {
              "type": "numeric",
              "scenario": "0℃附近空气示例",
              "expr": "3.6*c",
              "ref": 1188,
              "note": "在 0℃ 附近取空气声速约 330 m/s，330 × 3.6 = 1188 km/h，独立核算后录入。"
            },
            {
              "type": "direction",
              "scenario": "近距离直达测量",
              "var": "c",
              "lo": 100,
              "hi": 500,
              "expr": "3.6*c",
              "expect": "up",
              "note": "换算比例固定为正数，原速度增大时换算后的速度也增大。"
            },
            {
              "type": "scan",
              "scenario": "近距离直达测量",
              "var": "c",
              "lo": 1,
              "hi": 1500,
              "note": "检查正声速范围内的单位换算稳定。"
            },
            {
              "type": "consistency",
              "scenario": "近距离直达测量",
              "with": "sound-01|米每秒与千米每小时的换算",
              "with_expr": "3.6*s/t",
              "target": "同一声速换算成千米每小时后的数值",
              "note": "本公式直接求v；参考端显式关系为3.6*s/t。两端使用同一情境和阶段，只核对该关系；with字段仅定位来源，不代表调用另一条被覆盖的公式。",
              "verification_kind": "独立关系核对"
            }
          ]
        }
      ],
      "derivation": [
        "先选定声源与接收位置，明确测量的是声音实际走过的直达路程 s。",
        "记录声音走完这段路程所用的时间 t；路程和时间的单位要先统一。",
        "用 c = s/t 求出 m/s；若需要 km/h，再把 m/s 的数值乘以 3.6。",
        "声音是否由振动产生、传播是否需要介质，仍需依靠观察和实验现象判断。"
      ],
      "errors": [
        {
          "wrong": "把 m/s 换成 km/h 时把 3.6 除上去，写成 v = c/3.6。",
          "wrong_expr": "v = c/3.6",
          "why": "从米每秒换到千米每小时要同时把米换成千米、秒换成小时，数值应乘 3.6。把 340 m/s 除以 3.6 得到约 94.4 km/h，与正确的 1224 km/h 不符；这是量纲相同但方向错误的单位换算，必须靠数值检查发现。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "近距离直达测量",
            "expr": "c/3.6",
            "ref": 1224
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "把声速写成路程乘时间，c = s·t。",
          "wrong_expr": "c = s*t",
          "why": "声速定义为单位时间内传播的路程，应使用路程除以时间。相乘后单位变成 m·s，不是 m/s，量纲检查能抓住。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "kind": "dimension",
            "target": "c = s*t",
            "lhs_dim": "L·T^-1",
            "rhs_dim": "L·T",
            "expect": "mismatch",
            "note": "实际量纲检查得到等号左边为L·T^-1、右边为L·T；两边不是同一物理量，因此该等式不成立。"
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "认为声音能在真空中传播，只是传播得比较慢。",
          "why": "声波传播依靠介质中的振动传递；真空没有这种介质。需要用真空罩实验现象和机械波概念辨析，不能由声速计算式判定。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "在空气中测得一段直达声传播 34 m 用时 0.10 s。求声速，并换算成 km/h。",
        "solution": [
          "由声速定义，c = s/t = 34/0.10 = 340 m/s。",
          "换算为 km/h：v = 3.6c = 3.6×340 = 1224 km/h。",
          "检查单位：第一问是 m/s，第二问是 km/h；两者描述同一速度。"
        ],
        "answer": "声速为 340 m/s，即 1224 km/h。"
      },
