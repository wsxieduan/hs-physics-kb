{
  "chapter": "物质的物理属性",
  "order": 6,
  "intro": "按目录整理质量测量、密度，以及密度应用与其他物理属性的关系；未给没有可靠定量规律的属性硬编公式。",
  "points": [
    {
      "id": "prop-03",
      "title": "质量及其测量",
      "level": "基础",
      "definition": "质量表示物体所含物质的多少，国际单位是千克，实验中常用天平测量。物体从一个地点移到另一个地点，质量不因位置变化而改变；记录时应写清单位。",
      "meaning": "使用天平前先放平、调平衡，再把物体和砝码按规范放置，砝码质量与游码示数相加得到物体质量。称量结果常需在 g 与 kg 之间换算；克数与千克数表示同一质量，不代表物体发生变化。测量值应根据仪器分度值合理记录。",
      "symbols": {
        "m_g": {
          "desc": "以克记录的质量",
          "unit": "g"
        },
        "m_kg": {
          "desc": "同一质量以千克记录",
          "unit": "kg"
        }
      },
      "scenarios": {
        "小物体称量": {
          "m_g": 450,
          "m_kg": 0.45
        },
        "书包称量": {
          "m_g": 2500,
          "m_kg": 2.5
        }
      },
      "formulas": [
        {
          "name": "克换算为千克",
          "expr": "m_kg = m_g/1000",
          "when": "同一质量单位换算，1000 g=1 kg。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "小物体称量",
              "expr": "m_g/1000",
              "ref": 0.45,
              "note": "450 g=0.45 kg。 "
            },
            {
              "type": "numeric",
              "scenario": "书包称量",
              "expr": "m_g/1000",
              "ref": 2.5,
              "note": "2500 g=2.5 kg。 "
            },
            {
              "type": "direction",
              "scenario": "小物体称量",
              "var": "m_g",
              "lo": 1,
              "hi": 5000,
              "expr": "m_g/1000",
              "expect": "up",
              "note": "克数增大时，千克数按比例增大。 "
            },
            {
              "type": "scan",
              "scenario": "小物体称量",
              "var": "m_g",
              "lo": 0.1,
              "hi": 10000,
              "note": "扫描正质量，单位换算保持有限。 "
            },
            {
              "type": "consistency",
              "scenario": "小物体称量",
              "with": "prop-03|克换算为千克",
              "with_expr": "m_kg",
              "target": "同一质量以千克记录",
              "note": "直接求本公式输出，与情境中另列的m_kg设计基准核对；数据是设计示例，不是实测。用于核对定义、反算或边界值，不宣称不同物理原理互证。",
              "verification_kind": "独立设计情境数据核对",
              "tol": 1e-06
            }
          ]
        },
        {
          "name": "千克换算为克",
          "expr": "m_g = 1000*m_kg",
          "when": "同一质量单位换算，1 kg=1000 g。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "小物体称量",
              "expr": "1000*m_kg",
              "ref": 450,
              "note": "0.45 kg=450 g。 "
            },
            {
              "type": "numeric",
              "scenario": "书包称量",
              "expr": "1000*m_kg",
              "ref": 2500,
              "note": "2.5 kg=2500 g。 "
            },
            {
              "type": "direction",
              "scenario": "书包称量",
              "var": "m_kg",
              "lo": 0.01,
              "hi": 50,
              "expr": "1000*m_kg",
              "expect": "up",
              "note": "千克数增大时，克数相应增大。 "
            },
            {
              "type": "scan",
              "scenario": "书包称量",
              "var": "m_kg",
              "lo": 0.001,
              "hi": 100,
              "note": "扫描正质量，换算数值保持稳定。 "
            }
          ]
        }
      ],
      "derivation": [
        "用天平测得物体质量，并记录天平示数和所用质量单位。",
        "按 1 kg=1000 g 换算：克换成千克除以 1000，千克换成克乘以 1000。",
        "换算后再反向换回，核对读数是否与原始称量一致。"
      ],
      "errors": [
        {
          "wrong": "克换千克时少除一个 10，产生十倍偏差。",
          "wrong_expr": "m_kg = m_g/100",
          "why": "450 g 应为 0.45 kg；若只除以 100，会得到 4.5 kg。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "小物体称量",
            "expr": "m_g/100",
            "ref": 0.45
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "认为物体移到月球后质量随重力变小。",
          "why": "质量表示物体所含物质多少，不随位置变化；变化的是物体受到的重力。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "天平测得一块金属质量为 780 g，换算成千克。",
        "solution": [
          "1000 g=1 kg。",
          "780÷1000=0.780 kg。"
        ],
        "answer": "质量为 0.780 kg。"
      },
      "prereq": [],
      "next": [
        "prop-01"
      ],
      "tags": [
        "质量",
        "天平",
        "千克",
        "克",
        "质量测量"
      ],
      "core": [
        {
          "title": "质量与天平",
          "text": "质量不随形状、状态、位置变化而改变，封闭相变后总质量不变。托盘天平水平放置，游码归零后调平衡螺母；左物右码，用镊子加减砝码，称量时不再调平衡螺母，游码读左缘。物体质量为右盘砝码质量加游码读数，且不能超量程；潮湿、有腐蚀性样品使用合适容器。1 t=1000 kg，1 kg=1000 g，1 g=1000 mg。"
        },
        {
          "title": "本章素养回顾（原创任务）",
          "text": "选择本章一个现象，写出结论、成立条件和证据；用另一条本章规律复核解释是否矛盾。指出一次测量或模型的局限，并说明还需什么证据；数值通过不替代概念辨析。"
        }
      ],
      "experiments": [
        {
          "title": "用托盘天平测量物体质量",
          "purpose": "测固体或带容器液体的质量。",
          "apparatus": "托盘天平、砝码、镊子、干燥物体或烧杯。",
          "variables": "测前游码归零、空载调平；称量中只改砝码和游码。",
          "steps": [
            "天平放平、游码归零、调平衡螺母。",
            "左物右码，用镊子先大后小加减砝码，移动游码使平衡。",
            "读砝码总质量加游码左缘读数，写单位并归整器材。"
          ],
          "data": "设计示例（非实测）：50 g砝码加游码2.4 g，质量52.4 g=0.0524 kg。",
          "conclusion": "质量由砝码与游码合计得到，不受普通位置和形状变化影响。",
          "limits": "物码颠倒时不能照常相加；游码未归零、超量程、手拿砝码或样品滴漏造成误差。",
          "kind": "学生必做"
        }
      ],
      "evidence": [
        {
          "kind": "conversion",
          "value": 52.4,
          "from_unit": "g",
          "expected": 0.0524,
          "to_unit": "kg",
          "note": "克转千克除以1000。"
        }
      ],
      "learning_scope": "初中"
    },
    {
      "id": "prop-01",
      "title": "密度",
      "level": "基础",
      "definition": "密度是物质单位体积的质量，等于物体质量与体积之比。对同一种均匀物质，密度通常可用于识别材料；物体质量和体积同时变化时，不能只凭其中一个量判断密度。",
      "meaning": "测密度要分别可靠地测质量和体积，再用质量除以体积；不规则物体可用排水法测体积。读质量—体积图线时，密度对应斜率而不是任意一点的纵坐标。先统一质量和体积单位，常见换算为 1 g/cm³=1000 kg/m³。",
      "symbols": {
        "m": {
          "desc": "物体质量",
          "unit": "kg"
        },
        "V": {
          "desc": "物体体积",
          "unit": "m^3"
        },
        "rho": {
          "desc": "物质密度",
          "unit": "kg/m^3"
        },
        "m_1": {
          "desc": "质量—体积图线上第一个读数点的质量",
          "unit": "kg"
        },
        "m_2": {
          "desc": "质量—体积图线上第二个读数点的质量",
          "unit": "kg"
        },
        "V_1": {
          "desc": "质量—体积图线上第一个读数点的体积",
          "unit": "m^3"
        },
        "V_2": {
          "desc": "质量—体积图线上第二个读数点的体积",
          "unit": "m^3"
        },
        "V1": {
          "desc": "放入物体前液体体积",
          "unit": "mL"
        },
        "V2": {
          "desc": "物体完全浸入后液体总体积",
          "unit": "mL"
        },
        "V_o": {
          "desc": "被测物体体积",
          "unit": "mL"
        }
      },
      "scenarios": {
        "一升水": {
          "m": 1,
          "V": 0.001,
          "rho": 1000
        },
        "两升水": {
          "m": 2,
          "V": 0.002,
          "rho": 1000
        },
        "水的质量体积图线一": {
          "m": 1,
          "V": 0.001,
          "rho": 1000,
          "m_1": 0.5,
          "V_1": 0.0005,
          "m_2": 1,
          "V_2": 0.001
        },
        "水的质量体积图线二": {
          "m": 1.5,
          "V": 0.0015,
          "rho": 1000,
          "m_1": 1,
          "V_1": 0.001,
          "m_2": 1.5,
          "V_2": 0.0015
        },
        "铝块测量一": {
          "V1": 50,
          "V2": 70,
          "V_o": 20,
          "m": 54,
          "rho": 2.7
        },
        "铝块测量二": {
          "V1": 40,
          "V2": 60,
          "V_o": 20,
          "m": 54,
          "rho": 2.7
        }
      },
      "formulas": [
        {
          "name": "由质量和体积求密度",
          "expr": "rho = m/V",
          "when": "质量和体积对应同一物体，且 m 用 kg、V 用 m^3。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "一升水",
              "expr": "m/V",
              "ref": 1000,
              "note": "1 kg ÷ 0.001 m^3 = 1000 kg/m^3。"
            },
            {
              "type": "numeric",
              "scenario": "两升水",
              "expr": "m/V",
              "ref": 1000,
              "note": "质量和体积同时加倍，密度仍为 1000 kg/m^3。"
            },
            {
              "type": "direction",
              "scenario": "一升水",
              "var": "m",
              "lo": 0.5,
              "hi": 2,
              "expr": "m/V",
              "expect": "up",
              "note": "体积不变时，质量增加会使密度计算值增加。"
            },
            {
              "type": "scan",
              "scenario": "一升水",
              "var": "V",
              "lo": 0.0005,
              "hi": 0.005,
              "note": "扫描正体积范围，检查密度计算稳定。"
            },
            {
              "type": "consistency",
              "scenario": "一升水",
              "with": "prop-01|由质量和体积求密度",
              "with_expr": "rho",
              "target": "物质密度",
              "note": "直接求本公式输出，与情境中另列的rho设计基准核对；数据是设计示例，不是实测。用于核对定义、反算或边界值，不宣称不同物理原理互证。",
              "verification_kind": "独立设计情境数据核对"
            }
          ]
        },
        {
          "name": "由密度和体积求质量",
          "expr": "m = rho*V",
          "when": "物体密度均匀，rho 用 kg/m^3、V 用 m^3。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "一升水",
              "expr": "rho*V",
              "ref": 1,
              "note": "1000 kg/m^3 × 0.001 m^3 = 1 kg。"
            },
            {
              "type": "numeric",
              "scenario": "两升水",
              "expr": "rho*V",
              "ref": 2,
              "note": "1000 kg/m^3 × 0.002 m^3 = 2 kg。"
            },
            {
              "type": "scan",
              "scenario": "一升水",
              "var": "V",
              "lo": 0.0005,
              "hi": 0.005,
              "note": "扫描正体积范围，质量按比例变化。"
            }
          ]
        },
        {
          "name": "读取质量—体积图线斜率求密度",
          "expr": "rho = (m_2-m_1)/(V_2-V_1)",
          "when": "同一种均匀物质的质量—体积图线为正比例关系，读数点体积不同且质量、体积单位统一。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "水的质量体积图线一",
              "expr": "(m_2-m_1)/(V_2-V_1)",
              "ref": 1000,
              "note": "图线上两点的质量差为 0.5 kg、体积差为 0.0005 m³，斜率为 1000 kg/m³。"
            },
            {
              "type": "numeric",
              "scenario": "水的质量体积图线二",
              "expr": "(m_2-m_1)/(V_2-V_1)",
              "ref": 1000,
              "note": "换用图线上另一段，两点差值之比仍为 1000 kg/m³。"
            },
            {
              "type": "consistency",
              "scenario": "水的质量体积图线一",
              "with": "prop-01|读取质量—体积图线斜率求密度",
              "with_expr": "m/V",
              "target": "物质密度",
              "note": "本公式直接求rho；参考端显式关系为m/V。两端使用同一情境和阶段，只核对该关系；with字段仅定位来源，不代表调用另一条被覆盖的公式。",
              "verification_kind": "独立关系核对"
            }
          ]
        }
      ],
      "derivation": [
        "密度定义为质量与体积的比值，先确认两者属于同一物体。",
        "用 m/V 计算密度并检查单位，kg 除以 m^3 得到 kg/m^3。",
        "在质量—体积图线上选取两个不同体积的点，用质量差除以体积差求斜率；均匀物质的该斜率就是密度。",
        "将定义式变形，可由密度和体积求质量。"
      ],
      "errors": [
        {
          "wrong": "把密度写成体积除以质量。",
          "wrong_expr": "rho = V/m",
          "why": "密度定义是单位体积的质量；质量越多而体积不变时，密度应增大。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "scenario": "一升水",
            "expr": "V/m",
            "ref": 1000
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "质量已经用 kg 表示时，又多除以 1000，造成密度少算 1000 倍。",
          "wrong_expr": "rho = (m/1000)/V",
          "why": "情境中的质量已是 kg，无须再次换算成吨；一升水应为 1000 kg/m^3，不是 1 kg/m^3。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "一升水",
            "expr": "(m/1000)/V",
            "ref": 1000
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "认为同一种物质的物体质量越大，密度一定越大。",
          "why": "在温度和状态相同、物质均匀时，质量和体积同比变化，密度不随样品多少改变。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "一块均匀材料质量为 2 kg，体积为 0.001 m^3，求密度。",
        "solution": [
          "rho=m/V=2/0.001=2000 kg/m^3。",
          "单位为 kg/m^3，表示每立方米该材料的质量。"
        ],
        "answer": "密度为 2000 kg/m^3。"
      },
