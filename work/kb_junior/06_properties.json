      "core": [
        {
          "title": "密度与单位",
          "text": "同种均匀材料在温度、状态相同条件下质量与体积成正比，比值称密度，不由样品多少决定。1 g/cm³=1000 kg/m³；1 mL=1 cm³，1 L=1000 mL=0.001 m³。水在普通室温下密度约1000 kg/m³，仅为近似；不同温度及物态会改变密度，水结冰质量不变但体积增大。"
        }
      ],
      "experiments": [
        {
          "title": "测量液体密度",
          "purpose": "用倒出液体质量与量筒体积测密度，减少残留误差。",
          "apparatus": "天平、烧杯、量筒、待测液体。",
          "variables": "同一样品，质量差对应倒入量筒的体积。",
          "steps": [
            "称烧杯加液体总质量。",
            "倒一部分进量筒，读凹液面最低处体积。",
            "再称烧杯加剩余液体质量，两次质量之差除以量筒体积。"
          ],
          "data": "设计示例（非实测）：初次80 g、剩余40 g，量筒50 mL，倒出40 g，密度0.8 g/cm³=800 kg/m³。",
          "conclusion": "相减后质量与实际倒出液体一一对应。",
          "limits": "若先称空杯再称全部液体，随后倒量筒且忽略杯壁残留，体积偏小而密度偏大；洒出液体也会破坏对应关系。",
          "kind": "学生必做"
        }
      ],
