            {
              "type": "direction",
              "scenario": "同向追及1秒",
              "var": "v_A",
              "lo": 5,
              "hi": 20,
              "expr": "v_A-v_B",
              "expect": "up",
              "note": "固定较慢物体速度时，较快物体速度增加，相对速度增大。 "
            },
            {
              "type": "scan",
              "scenario": "同向追及1秒",
              "var": "v_A",
              "lo": 4.1,
              "hi": 25,
              "note": "扫描 v_A 大于 v_B 的区间，相对速度保持为正。 "
