{
  "chapter": "物体的运动",
  "order": 5,
  "intro": "按苏科版2024目录整理长度与时间测量、速度、直线运动和运动相对性；速度换算与相对运动均注明单位、方向和适用条件。",
  "points": [
    {
      "id": "motion-03",
      "title": "长度与时间的测量",
      "level": "基础",
      "definition": "长度用刻度尺测量，时间可用秒表或计时器测量。读数要包含准确值和估读值，并记录单位；比较不同记录前应把长度换算到同一单位。",
      "meaning": "测量前先看量程、分度值和零刻线，放置刻度尺时让刻度线与被测边平行；读数时视线垂直刻度面。时间测量要明确起止事件并尽量重复测量减小偶然误差。米、厘米和千米之间的换算有固定比例，错误换算会造成数量级偏差。",
      "symbols": {
        "L_m": {
          "desc": "以米记录的长度",
          "unit": "m"
        },
        "L_cm": {
          "desc": "同一长度以厘米记录",
          "unit": "cm"
        },
        "L_km": {
          "desc": "同一长度以千米记录",
          "unit": "km"
        }
      },
      "scenarios": {
        "课桌长度": {
          "L_m": 1.2,
          "L_cm": 120,
          "L_km": 0.0012
        },
        "教室长度": {
          "L_m": 8.5,
          "L_cm": 850,
          "L_km": 0.0085
        }
      },
      "formulas": [
        {
          "name": "米换算为厘米",
          "expr": "L_cm = 100*L_m",
          "when": "同一长度的单位换算，1 m=100 cm。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "课桌长度",
              "expr": "100*L_m",
              "ref": 120,
              "note": "1.2 m 换算为 120 cm。 "
            },
            {
              "type": "numeric",
              "scenario": "教室长度",
              "expr": "100*L_m",
              "ref": 850,
              "note": "8.5 m 换算为 850 cm。 "
            },
            {
              "type": "direction",
              "scenario": "课桌长度",
              "var": "L_m",
              "lo": 0.1,
              "hi": 10,
              "expr": "100*L_m",
              "expect": "up",
              "note": "长度以米表示的数值增加时，厘米数按比例增加。 "
            },
            {
              "type": "scan",
              "scenario": "课桌长度",
              "var": "L_m",
              "lo": 0.01,
              "hi": 100,
              "note": "扫描正长度，单位换算结果保持有限。 "
            },
            {
              "type": "consistency",
              "scenario": "课桌长度",
              "with": "motion-03|米换算为厘米",
              "with_expr": "100000*L_km",
              "target": "同一长度以厘米记录",
              "note": "本公式直接求L_cm；参考端显式关系为100000*L_km。两端使用同一情境和阶段，只核对该关系；with字段仅定位来源，不代表调用另一条被覆盖的公式。",
              "verification_kind": "独立关系核对"
            }
          ]
        },
        {
          "name": "米换算为千米",
          "expr": "L_km = L_m/1000",
          "when": "同一长度的单位换算，1 km=1000 m。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "课桌长度",
              "expr": "L_m/1000",
              "ref": 0.0012,
              "note": "1.2 m 换算为 0.0012 km。 "
            },
            {
              "type": "numeric",
              "scenario": "教室长度",
              "expr": "L_m/1000",
              "ref": 0.0085,
              "note": "8.5 m 换算为 0.0085 km。 "
            },
            {
              "type": "direction",
              "scenario": "教室长度",
              "var": "L_m",
              "lo": 0.1,
              "hi": 10,
              "expr": "L_m/1000",
              "expect": "up",
              "note": "米数增加时，千米数也按比例增加。 "
            },
            {
              "type": "scan",
              "scenario": "教室长度",
              "var": "L_m",
              "lo": 0.01,
              "hi": 100,
              "note": "扫描正长度，换算数值保持稳定。 "
            }
          ]
        }
      ],
      "derivation": [
        "测量对象的长度与计时过程要先定义清楚，并选用合适量程的工具。",
        "记录读数时保留单位；将厘米换成米除以 100，将米换成千米除以 1000。",
        "用两种单位换算后再反算，检查数量级与原始测量是否一致。"
      ],
      "errors": [
        {
          "wrong": "把 1 m 误当作 10 cm，导致长度单位换算少一个数量级。",
          "wrong_expr": "L_cm = 10*L_m",
          "why": "1 m=100 cm；课桌长度 1.2 m 应为 120 cm，而不是 12 cm。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "课桌长度",
            "expr": "10*L_m",
            "ref": 120
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "读刻度尺时视线倾斜，造成视差并把估读值当作准确值。",
          "why": "视线应垂直刻度面；测量误差需结合分度值和重复测量分析。应记录仪器分度值并按规范重复测量。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "一张桌子的长度测得 1.2 m，分别换算成厘米和千米。",
        "solution": [
          "厘米：1.2×100=120 cm。",
          "千米：1.2÷1000=0.0012 km。"
        ],
        "answer": "120 cm；0.0012 km。"
      },
      "prereq": [],
      "next": [
        "motion-01"
      ],
      "tags": [
        "长度测量",
        "时间测量",
        "刻度尺",
        "秒表",
        "单位换算"
      ],
      "core": [
        {
          "title": "长度与时间：读数、误差和估测",
          "text": "刻度尺贴近被测长度并平行摆放，视线垂直刻度面；零端磨损时用两刻度差。连续刻度尺一般估读到分度值下一位，数字秒表按显示精度记录；多次测量取平均可减小部分偶然误差，不能消除系统偏差。1 km=1000 m，1 m=100 cm=1000 mm；1 h=3600 s。普通课桌高度常约0.6～0.9 m、成年人步行约0.8～1.8 m/s，仅作合理估计区间，不能替代实际测量。"
        },
        {
          "title": "本章素养回顾（原创任务）",
          "text": "选择本章一个现象，写出结论、成立条件和证据；用另一条本章规律复核解释是否矛盾。指出一次测量或模型的局限，并说明还需什么证据；数值通过不替代概念辨析。"
        }
      ],
      "experiments": [
        {
          "title": "用刻度尺测量长度",
          "purpose": "正确定位、估读并处理零端磨损。",
          "apparatus": "毫米刻度尺、薄板等被测物。",
          "variables": "保持同一物体，改变重复测量次数，不改变尺的量程。",
          "steps": [
            "检查量程分度值，选可用刻线对齐起点。",
            "刻度面贴近物体，视线垂直尺面读起点和终点。",
            "相减得长度，重复测量按有效精度记录平均值。"
          ],
          "data": "设计示例（非实测）：起点1.00 cm，终点4.26 cm，长度3.26 cm=0.0326 m。",
          "conclusion": "长度为两刻度差而非终点单个数。",
          "limits": "视差、尺未平行和零端磨损可形成系统偏差；平均不能消除这些错误。",
          "kind": "学生必做"
        },
        {
          "title": "用表测量时间",
          "purpose": "建立起止事件一致的时间间隔。",
          "apparatus": "数字秒表或机械秒表、可重复事件。",
          "variables": "相同事件，用同一起止约定，观察仪表示数。",
          "steps": [
            "辨显示分辨率，约定开始和结束事件。",
            "先练习启停，再重复计时。",
            "记录秒数，比较差异，说明人工反应时间。"
          ],
          "data": "设计示例（非实测）：3次为2.10、2.08、2.12 s，平均2.10 s；1 min 5 s为65 s。",
          "conclusion": "时间间隔依赖起止事件，单位换算不能把分钟当秒。",
          "limits": "人为启停反应对短过程占比大，重复可减少部分偶然影响，不可假称完全消除。",
          "kind": "学生必做"
        }
      ],
      "evidence": [
        {
          "kind": "range",
          "value": 0.75,
          "unit": "m",
          "lo": 0.6,
          "hi": 0.9,
          "note": "普通课桌高度的示例估计区间，实际桌型和年级可能不同。"
        }
      ],
      "learning_scope": "初中"
    },
    {
      "id": "motion-01",
      "title": "速度",
      "level": "基础",
      "definition": "速度表示物体运动的快慢，数值等于在计时区间内通过的路程与所用时间之比。相同时间内路程越长，速度越大；同一路程用时越短，速度越大。",
      "meaning": "比较快慢时可控制路程或时间中的一个量不变，也可统一用路程除以时间计算。速度是比值，平均速度描述一段过程而非每一瞬间；单位换算时 1 m/s=3.6 km/h。计算前确认距离和时间用相容单位。",
      "symbols": {
        "s": {
          "desc": "物体在计时区间内通过的路程",
          "unit": "m"
        },
        "t": {
          "desc": "通过路程 s 所用时间",
          "unit": "s"
        },
        "v": {
          "desc": "以米每秒表示的速度",
          "unit": "m/s"
        },
        "v_k": {
          "desc": "同一速度以千米每小时表示",
          "unit": "km/h"
        }
      },
      "scenarios": {
        "步行测量": {
          "s": 100,
          "t": 20,
          "v": 5,
          "v_k": 18
        },
        "操场跑步": {
          "s": 500,
          "t": 100,
          "v": 5,
          "v_k": 18
        }
      },
      "formulas": [
        {
          "name": "由路程和时间求速度",
          "expr": "v = s/t",
          "when": "路程和时间来自同一运动区间，s 用 m、t 用 s。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "步行测量",
              "expr": "s/t",
              "ref": 5,
              "note": "100 m ÷ 20 s = 5 m/s。"
            },
            {
              "type": "numeric",
              "scenario": "操场跑步",
              "expr": "s/t",
              "ref": 5,
              "note": "500 m ÷ 100 s = 5 m/s，另一组测量复算。"
            },
            {
              "type": "direction",
              "scenario": "步行测量",
              "var": "s",
              "lo": 50,
              "hi": 200,
              "expr": "s/t",
              "expect": "up",
              "note": "计时相同时，路程越长，平均速度越大。"
            },
            {
              "type": "scan",
              "scenario": "步行测量",
              "var": "t",
              "lo": 1,
              "hi": 200,
              "note": "扫描正计时范围，检查速度计算稳定。"
            },
            {
              "type": "consistency",
              "scenario": "步行测量",
              "with": "motion-01|由路程和时间求速度",
              "with_expr": "v_k/3.6",
              "target": "以米每秒表示的速度",
              "note": "本公式直接求v；参考端显式关系为v_k/3.6。两端使用同一情境和阶段，只核对该关系；with字段仅定位来源，不代表调用另一条被覆盖的公式。",
              "verification_kind": "独立关系核对"
            }
          ]
        },
        {
          "name": "米每秒换算为千米每小时",
          "expr": "v_k = 3.6*v",
          "when": "原速度用 m/s 表示，换算后的速度用 km/h 表示。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "步行测量",
              "expr": "3.6*v",
              "ref": 18,
              "note": "5 m/s × 3.6 = 18 km/h。"
            },
            {
              "type": "numeric",
              "scenario": "操场跑步",
              "expr": "3.6*v",
              "ref": 18,
              "note": "同一速度的换算值保持一致。"
            },
            {
              "type": "direction",
              "scenario": "步行测量",
              "var": "v",
              "lo": 1,
              "hi": 20,
              "expr": "3.6*v",
              "expect": "up",
              "note": "正比例换算，原速度增大时 km/h 数值增大。"
            },
            {
              "type": "scan",
              "scenario": "步行测量",
              "var": "v",
              "lo": 0,
              "hi": 50,
              "note": "扫描非负速度范围，换算结果保持有限。"
            }
          ]
        }
      ],
      "derivation": [
        "用刻度尺测出运动路程 s，用秒表测出相应时间 t。",
        "依据速度定义计算 v=s/t；m 除以 s 得到 m/s。",
        "如需换成 km/h，把 m/s 数值乘 3.6，并在比较前统一速度单位。"
      ],
      "errors": [
        {
          "wrong": "把速度写成路程乘时间。",
          "wrong_expr": "v = s*t",
          "why": "速度是单位时间内通过的路程，需用路程除以时间；相乘的单位也不再是 m/s。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "scenario": "步行测量",
            "expr": "s*t",
            "ref": 5
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "换算 m/s 与 km/h 时忘记乘 3.6，或把乘除方向写反。",
          "why": "1 m/s=3.6 km/h；5 m/s 应为 18 km/h，而不是约 1.4 km/h。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "步行测量",
            "expr": "v/3.6",
            "ref": 18
          },
          "wrong_expr": "v_k = v/3.6",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "小明沿同一直线同方向在20 s内走过100 m，求这段平均速度大小并换算成km/h。",
        "solution": [
          "v=s/t=100/20=5 m/s。",
          "换算为 km/h：5×3.6=18 km/h。"
        ],
        "answer": "平均速度为 5 m/s，即 18 km/h。"
      },
      "prereq": [],
      "next": [
        "motion-02"
      ],
      "tags": [
        "速度",
        "路程",
        "时间",
        "单位换算"
      ],
      "core": [
        {
          "title": "速度与平均速度",
          "text": "初中速度侧重路程与时间之比。测某一段平均速度先标记该段起终点，用本段路程除以本段时间；全程平均速度要用总路程除以总时间，包含题目规定的停留时间。1 m/s=3.6 km/h；72 km/h=20 m/s。估测不能把生活中的速度当人人相同的固定常数。"
        }
      ],
      "experiments": [
        {
          "title": "测量物体运动的速度",
          "purpose": "测斜面小车某段平均速度。",
          "apparatus": "缓斜面、小车、刻度尺、计时器、终点挡板。",
          "variables": "明确同一段起终位置，同一释放条件，观察通过该段时间。",
          "steps": [
            "量起点到终点的实际路程，标记两点。",
            "静止释放同时计时，到达终点停止计时。",
            "重复测量，分别用各段路程除各段时间，不将全程时间用于半段。"
          ],
          "data": "设计示例（非实测）：0.80 m用时2.0 s，平均0.40 m/s；下半段0.40 m用时0.8 s，平均0.50 m/s。",
          "conclusion": "加速过程不同区段平均速度可不同，不能当处处匀速。",
          "limits": "斜面过陡会放大启停误差，挡板位置、车长和起点约定影响路程。",
          "kind": "学生必做"
        }
      ],
      "evidence": [
        {
          "kind": "conversion",
          "value": 72,
          "from_unit": "km/h",
          "expected": 20,
          "to_unit": "m/s",
          "note": "72 km/h每秒行20 m；先小时换秒再千米换米。"
        },
        {
          "kind": "range",
          "value": 1.2,
          "unit": "m/s",
          "lo": 0.8,
          "hi": 1.8,
          "note": "成年人普通步行的参考区间，个人步速不是固定标准。"
        }
      ],
      "learning_scope": "初中"
    },
    {
      "id": "motion-02",
      "title": "直线运动",
      "level": "基础",
      "definition": "物体沿直线运动时，位置随时间变化。若相等时间内通过相等路程，运动是匀速直线运动；运动快慢改变时属于变速直线运动，常用全程平均速度描述整体快慢。",
      "meaning": "分段运动的全程平均速度要用总路程除以总时间，不能把各段速度简单平均，除非时间或路程条件恰好支持。利用运动图像还要先读横纵轴和单位；折线斜率或面积的含义须根据图轴定义判断。",
      "symbols": {
        "s1": {
          "desc": "第一段路程",
          "unit": "m"
        },
        "s2": {
          "desc": "第二段路程",
          "unit": "m"
        },
        "t1": {
          "desc": "第一段用时",
          "unit": "s"
        },
        "t2": {
          "desc": "第二段用时",
          "unit": "s"
        },
        "s_total": {
          "desc": "全程总路程",
          "unit": "m"
        },
        "t_total": {
          "desc": "全程总时间",
          "unit": "s"
        },
        "v_avg": {
          "desc": "全程平均速度",
          "unit": "m/s"
        },
        "v1": {
          "desc": "第一段平均速度",
          "unit": "m/s"
        },
        "v2": {
          "desc": "第二段平均速度",
          "unit": "m/s"
        }
      },
      "scenarios": {
        "两段各100米": {
          "s1": 100,
          "s2": 100,
          "t1": 10,
          "t2": 50,
          "s_total": 200,
          "t_total": 60,
          "v_avg": 3.3333333333333335,
          "v1": 10,
          "v2": 2
        },
        "两段等时": {
          "s1": 60,
          "s2": 20,
          "t1": 10,
          "t2": 10,
          "s_total": 80,
          "t_total": 20,
          "v_avg": 4,
          "v1": 6,
          "v2": 2
        }
      },
      "formulas": [
        {
          "name": "分段路程和时间求全程平均速度",
          "expr": "v_avg = (s1+s2)/(t1+t2)",
          "when": "总路程为各段路程之和，总时间为各段用时之和。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "两段各100米",
              "expr": "(s1+s2)/(t1+t2)",
              "ref": 3.3333333333333335,
              "note": "200 m ÷ 60 s ≈ 3.33 m/s。"
            },
            {
              "type": "numeric",
              "scenario": "两段等时",
              "expr": "(s1+s2)/(t1+t2)",
              "ref": 4,
              "note": "80 m ÷ 20 s = 4 m/s。"
            },
            {
              "type": "direction",
