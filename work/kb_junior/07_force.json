              "expr": "F_pull-F_f",
              "ref": 0,
              "note": "2.5 N 拉力与 2.5 N 摩擦力方向相反，合力为零。 "
            },
            {
              "type": "numeric",
              "scenario": "改变压力后匀速滑动",
