{
  "chapter": "力",
  "order": 7,
  "intro": "按苏科版2024目录整理力与弹力、重力与力的示意图、摩擦力和力的相互作用；弹簧线性关系单列为拓展，摩擦力计算严格限定实验条件。",
  "points": [
    {
      "id": "force-03",
      "title": "力 弹力",
      "level": "拓展",
      "definition": "物体发生弹性形变时会产生弹力，弹力方向与形变方向相反。对形变范围内近似线性的弹簧，弹力大小可用弹簧劲度系数与形变量的乘积估算；超出弹性范围时不能套用线性关系。",
      "meaning": "弹力可以通过弹簧测力计感受和测量，弹簧伸长量越大，弹力通常越大。这里的 F=kx 是线性弹簧的拓展模型，教材基础要求主要是辨认弹力、方向和产生条件；实际弹簧若发生明显弯折、塑性形变或接近极限，比例关系不再适用。",
      "symbols": {
        "F_e": {
          "desc": "弹簧弹力大小",
          "unit": "N"
        },
        "k": {
          "desc": "线性弹簧劲度系数",
          "unit": "N/m"
        },
        "x": {
          "desc": "弹簧相对原长的形变量",
          "unit": "m"
        }
      },
      "scenarios": {
        "小形变弹簧": {
          "F_e": 2,
          "k": 100,
          "x": 0.02
        },
        "另一弹簧": {
          "F_e": 3,
          "k": 150,
          "x": 0.02
        }
      },
      "formulas": [
        {
          "name": "线性弹簧弹力与形变量关系",
          "expr": "F_e = k*x",
          "when": "拓展计算，非本卡初中必背主线。仅用于弹性限度内近似线性的弹簧；x 是相对原长的形变量。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "小形变弹簧",
              "expr": "k*x",
              "ref": 2,
              "note": "劲度系数 100 N/m、形变量 0.02 m，对应弹力 2 N。 "
            },
            {
              "type": "numeric",
              "scenario": "另一弹簧",
              "expr": "k*x",
              "ref": 3,
              "note": "劲度系数 150 N/m、形变量 0.02 m，对应弹力 3 N。 "
            },
            {
              "type": "direction",
              "scenario": "小形变弹簧",
              "var": "x",
              "lo": 0.001,
              "hi": 0.05,
              "expr": "k*x",
              "expect": "up",
              "note": "在线性范围内，形变量增大时弹力增大。 "
            },
            {
              "type": "scan",
              "scenario": "小形变弹簧",
              "var": "x",
              "lo": 0,
              "hi": 0.1,
              "note": "扫描非负小形变，估算弹力保持有限。 "
            },
            {
              "type": "consistency",
              "scenario": "小形变弹簧",
              "with": "force-03|线性弹簧弹力与形变量关系",
              "with_expr": "F_e",
              "target": "弹簧弹力大小",
              "note": "直接求本公式输出，与情境中另列的F_e设计基准核对；数据是设计示例，不是实测。用于核对定义、反算或边界值，不宣称不同物理原理互证。",
              "verification_kind": "独立设计情境数据核对"
            }
          ]
        },
        {
          "name": "由弹力和劲度系数求形变量",
          "expr": "x = F_e/k",
          "when": "拓展计算，非本卡初中必背主线。弹簧仍在线性弹性范围内，k 大于零。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "小形变弹簧",
              "expr": "F_e/k",
              "ref": 0.02,
              "note": "2 N ÷ 100 N/m=0.02 m。 "
            },
            {
              "type": "numeric",
              "scenario": "另一弹簧",
              "expr": "F_e/k",
              "ref": 0.02,
              "note": "3 N ÷ 150 N/m=0.02 m。 "
            },
            {
              "type": "direction",
              "scenario": "小形变弹簧",
              "var": "F_e",
              "lo": 0.1,
              "hi": 10,
              "expr": "F_e/k",
              "expect": "up",
              "note": "劲度系数固定时弹力增大，形变量增大。 "
            },
            {
              "type": "scan",
              "scenario": "小形变弹簧",
              "var": "F_e",
              "lo": 0,
              "hi": 20,
              "note": "扫描非负弹力范围，反推形变量有限。 "
            }
          ]
        }
      ],
      "derivation": [
        "确定弹簧原长和受力后的长度，两者之差为形变量 x。",
        "在线性弹性范围内，实验表明弹力大小与形变量成正比，比例系数为 k。",
        "使用 F_e=kx 前检查弹簧没有超过弹性限度，并统一 N、N/m 和 m。"
      ],
      "errors": [
        {
          "wrong": "误把弹力大小写成线性弹簧kx的一半。",
          "wrong_expr": "F_e = k*x/2",
          "why": "弹性限度内的线性弹簧关系为kx，不带二分之一；这里是错误增加了除2，不是漏掉正确系数。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "小形变弹簧",
            "expr": "k*x/2",
            "ref": 2
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "认为任何材料、任何形变都遵守线性弹簧关系。",
          "why": "线性关系只适用于弹性限度内近似线性的弹簧；塑性形变或超过弹性限度时不可套用。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "劲度系数为 100 N/m 的弹簧在弹性限度内伸长 0.03 m，估算弹力。",
        "solution": [
          "确认形变量在弹性限度内。",
          "F_e=kx=100×0.03=3 N。"
        ],
        "answer": "弹力约为 3 N。"
      },
