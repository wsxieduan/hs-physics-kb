      ],
      "core": [
        {
          "title": "力、弹力与测力计",
          "text": "力是物体间相互作用，能使物体形变或改变运动状态；大小、方向、作用点是力的三要素。弹性形变恢复时产生弹力，塑性形变不一定可恢复。弹簧测力计使用前看量程、分度值并沿受力方向调零，力沿轴线、待示数稳定后读数，不超量程。弹簧正比式仅是拓展模型，不是所有材料普遍定律。"
        },
        {
          "title": "本章素养回顾（原创任务）",
          "text": "选择本章一个现象，写出结论、成立条件和证据；用另一条本章规律复核解释是否矛盾。指出一次测量或模型的局限，并说明还需什么证据；数值通过不替代概念辨析。"
        }
      ],
      "experiments": [
        {
          "title": "用弹簧测力计测量力",
          "purpose": "沿轴线读取力的大小。",
          "apparatus": "合适量程测力计、钩码。",
          "variables": "同一仪器沿受力方向调零，观察稳定读数。",
          "steps": [
            "确认量程和分度值、沿使用方向调零。",
            "悬挂钩码使力沿轴线，避免侧向卡碰。",
            "稳定后垂直刻度面读数，取下钩码检查归零。"
          ],
          "data": "设计示例（非实测）：分度值0.1 N、示数1.5 N，不能写1.5 kg。",
          "conclusion": "示数表示拉力大小；静止悬挂时可等于钩码重力。",
          "limits": "超量程、侧拉、零点偏移和摆动会影响读数，不能用未校正示数直接比较。",
          "kind": "学生必做"
        }
      ],
      "learning_scope": "初中主线；公式含拓展"
    },
    {
      "id": "force-01",
      "title": "重力 力的示意图",
      "level": "基础",
      "definition": "地球附近的物体受到重力，重力方向竖直向下，大小与物体质量近似成正比。力的示意图用带箭头的线段表示力的大小、方向和作用点；作图前先选定研究对象。",
      "meaning": "在地球表面附近常用 G=mg 估算重力，比例系数 g 约为 9.8 N/kg，粗略计算可取 10 N/kg。质量和重力不是同一个量：质量用 kg，重力用 N。画示意图时箭头方向表示力方向，线段长短可按比例表示大小，不要把重力方向画成总是垂直于斜面。",
      "symbols": {
        "G": {
          "desc": "物体所受重力",
          "unit": "N"
        },
        "m": {
          "desc": "物体质量",
          "unit": "kg"
        },
        "mg": {
          "desc": "以克记录的质量数值，代入前要换成 kg",
          "unit": "g"
        },
        "g": {
          "desc": "当地重力与质量的比值，估算取 10 N/kg",
          "unit": "N/kg"
        },
        "F_AB": {
          "desc": "物体 A 对物体 B 的作用力大小",
          "unit": "N"
        },
        "F_BA": {
          "desc": "物体 B 对物体 A 的作用力大小",
          "unit": "N"
        },
        "F_ABx": {
          "desc": "A 对 B 的作用力沿选定方向的分量，正负表示方向",
          "unit": "N"
        },
        "F_BAx": {
          "desc": "B 对 A 的作用力沿同一选定方向的分量，正负表示方向",
          "unit": "N"
        },
        "F_sum": {
          "desc": "这两个相互作用力沿选定方向的分量代数和",
          "unit": "N"
        }
      },
      "scenarios": {
        "小球": {
          "G": 2,
          "m": 0.2,
          "g": 10
        },
        "书包": {
          "G": 20,
          "m": 2,
          "g": 10
        },
        "克单位误代": {
          "G": 2,
          "m": 0.2,
          "mg": 200,
          "g": 10
        },
        "手推墙": {
          "F_AB": 5,
          "F_BA": 5,
          "F_ABx": 5,
          "F_BAx": -5,
          "F_sum": 0
        },
        "两磁体排斥": {
          "F_AB": 12,
          "F_BA": 12,
          "F_ABx": 12,
          "F_BAx": -12,
          "F_sum": 0
        }
      },
      "formulas": [
        {
          "name": "质量与重力的关系",
          "expr": "G = m*g",
          "when": "近地面估算时取 g≈10 N/kg；更精确计算可按题目给定 g。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "小球",
              "expr": "m*g",
              "ref": 2,
              "note": "0.2 kg×10 N/kg=2 N。"
            },
            {
              "type": "numeric",
              "scenario": "书包",
              "expr": "m*g",
              "ref": 20,
              "note": "2 kg×10 N/kg=20 N。"
            },
            {
              "type": "direction",
              "scenario": "小球",
              "var": "m",
              "lo": 0.1,
              "hi": 5,
              "expr": "m*g",
              "expect": "up",
              "note": "同一地点 g 固定，质量增大则重力增大。"
            },
            {
              "type": "scan",
              "scenario": "小球",
              "var": "m",
              "lo": 0,
              "hi": 100,
              "note": "扫描非负质量范围，重力随质量线性变化。"
            },
            {
              "type": "consistency",
              "scenario": "小球",
              "with": "force-01|质量与重力的关系",
              "with_expr": "G",
              "target": "物体所受重力",
              "note": "直接求本公式输出，与情境中另列的G设计基准核对；数据是设计示例，不是实测。用于核对定义、反算或边界值，不宣称不同物理原理互证。",
              "verification_kind": "独立设计情境数据核对"
            }
          ]
        },
        {
          "name": "由重力估算质量",
          "expr": "m = G/g",
          "when": "重力 G 与当地重力加速度 g 已知，且 g 不为零。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "小球",
              "expr": "G/g",
              "ref": 0.2,
              "note": "2 N÷10 N/kg=0.2 kg。"
            },
            {
              "type": "numeric",
              "scenario": "书包",
              "expr": "G/g",
              "ref": 2,
              "note": "20 N÷10 N/kg=2 kg。"
            },
            {
              "type": "scan",
              "scenario": "小球",
              "var": "G",
              "lo": 0,
              "hi": 100,
              "note": "扫描非负重力范围，反算质量保持有限。"
            }
          ]
        }
      ],
      "derivation": [
        "物体质量为 m，每千克物体受到的重力用 g 表示。",
        "重力随质量成正比，所以重力大小为 G=m*g。",
        "移项可由重力与当地 g 反算物体质量。"
      ],
      "errors": [
        {
          "wrong": "把重力写成质量除以 g。",
          "wrong_expr": "G = m/g",
          "why": "g 的单位是 N/kg，重力应为 m*g 才得到 N；除法会得到不符合力单位的结果。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "scenario": "小球",
            "expr": "m/g",
            "ref": 2
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "质量以克记录时，把克的数值直接当作 kg 代入重力公式。",
          "wrong_expr": "G = mg*g",
          "why": "200 g 应先换成 0.2 kg；把数值 200 直接代入会把重力算大 1000 倍。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "克单位误代",
            "expr": "mg*g",
            "ref": 2
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "把质量和重力看成同一个量，直接用 kg 表示重力。",
          "why": "质量单位为 kg，重力单位为 N；二者通过当地 g 联系，但概念和单位不同。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "一只质量 3 kg 的物体在地面附近运动，取 g=10 N/kg，求其重力。",
        "solution": [
          "G=mg=3×10=30 N。",
          "重力方向竖直向下。"
        ],
        "answer": "重力大小为 30 N，方向竖直向下。"
      },
      "prereq": [],
      "next": [
        "force-02"
      ],
      "tags": [
        "重力",
        "质量",
        "力的示意图",
        "竖直向下"
      ],
      "core": [
        {
          "title": "重力与示意图",
          "text": "重力源于地球对物体的吸引，方向竖直向下，重心是画重力示意图的作用点模型。规则、均匀物体常取几何中心，不规则或不均匀物体需另判。悬线可帮助确定竖直方向；沿重心画带箭头线段并标重力。g可近似9.8 N/kg，题目指定10 N/kg则按指定值；不能把质量克数直接乘g。"
        }
      ],
      "learning_scope": "初中"
    },
    {
      "id": "force-04",
      "title": "摩擦力",
      "level": "基础",
      "definition": "两个相互接触的物体发生或将要发生相对运动时，接触面会产生阻碍相对运动的摩擦力。摩擦力方向沿接触面，且与相对运动或相对运动趋势方向相反。",
      "meaning": "摩擦力大小受压力和接触面情况等因素影响，不能仅凭物体是否运动判断。水平面上用弹簧测力计匀速拉动木块，若水平方向只受拉力和滑动摩擦力，则两力平衡，拉力读数等于摩擦力大小。改变条件时要区分静摩擦和滑动摩擦，不能把本实验结论推广到所有情况。",
