      "core": [
        {
          "title": "摩擦力",
          "text": "滑动摩擦力与接触面粗糙程度、压力有关。研究压力时保持接触面相同；研究粗糙程度时保持压力相同。水平匀速拉木块时拉力可代替摩擦力大小，非匀速就不能直接等同。走路时地面对脚的摩擦力可向前，摩擦不总是阻碍物体相对地面运动。润滑、变滑动为滚动可减小部分摩擦，纹路和增压可增大部分摩擦。"
        }
      ],
      "experiments": [
        {
          "title": "探究滑动摩擦力大小的影响因素",
          "purpose": "区分压力与接触面粗糙程度。",
          "apparatus": "木块、测力计、木板、粗糙面、砝码。",
          "variables": "改变压力时保持接触面，改变粗糙程度时保持压力；观察匀速读数。",
          "steps": [
            "沿水平拉木块做匀速直线运动，读稳定拉力。",
            "加砝码而保持接触面不变，重复。",
            "换粗糙面而保持总压力不变，重复并分组比较。"
          ],
          "data": "设计示例（非实测）：同面压力由2 N增到4 N，拉力由0.6 N增到1.2 N；压力2 N换粗糙面，拉力可变0.9 N。",
          "conclusion": "在该实验范围内，压力大或接触面粗糙时滑动摩擦力通常较大；不由两点数据宣称普遍精确比例。",
          "limits": "拉力不水平或运动不匀速时不能直接代替摩擦力；压力不是任意情况下的重力。",
          "kind": "学生必做"
        }
      ],
      "learning_scope": "初中"
    },
    {
      "id": "force-02",
      "title": "力的作用是相互的",
      "level": "基础",
      "definition": "物体间的相互作用总是成对出现：物体 A 对 B 施力时，B 同时对 A 施加大小相等、方向相反的力。两力作用在不同物体上，因此不会互相抵消。",
      "meaning": "判断一对相互作用力时要同时指出施力物体和受力物体，再比较大小、方向和作用时间。船桨推水、水推船向前，说明作用力和反作用力分别作用在不同物体上。不能把它们误当成同一物体的平衡力。",
      "symbols": {
        "F_AB": {
          "desc": "物体 A 对物体 B 的作用力大小",
          "unit": "N"
        },
        "F_BA": {
          "desc": "物体 B 对物体 A 的作用力大小",
          "unit": "N"
        },
        "F_ABx": {
          "desc": "A 对 B 的作用力沿选定方向的分量，正负表示方向",
          "unit": "N"
        },
        "F_BAx": {
          "desc": "B 对 A 的作用力沿同一选定方向的分量，正负表示方向",
          "unit": "N"
        },
        "F_sum": {
          "desc": "这两个相互作用力沿选定方向的分量代数和",
          "unit": "N"
        }
      },
