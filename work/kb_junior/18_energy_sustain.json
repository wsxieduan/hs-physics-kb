              "ref": 0.6,
              "note": "60 J÷100 J=0.6，即 60%。"
            },
            {
              "type": "direction",
              "scenario": "高效电机",
              "var": "E_use",
              "lo": 0,
              "hi": 100,
              "expr": "E_use/E_in",
              "expect": "up",
              "note": "输入能量固定时，有用输出增加，效率提高。"
            },
            {
              "type": "scan",
              "scenario": "高效电机",
              "var": "E_in",
              "lo": 1,
              "hi": 10000,
              "note": "扫描正输入能量，效率计算不会除以零。"
            },
            {
              "type": "compare",
              "scenario": "高效电机",
