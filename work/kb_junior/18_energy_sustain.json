            {
              "type": "scan",
              "scenario": "节能灯具一",
              "var": "t_use",
              "lo": 0,
              "hi": 10000000,
              "note": "扫描非负使用时长，能耗估算保持有限。"
            }
          ]
        },
        {
          "name": "计算新设备在相同服务时段的耗电量",
          "expr": "E_new = P_new*t_use",
