          "checks": [
            {
              "type": "numeric",
              "scenario": "节能灯具一",
              "expr": "P_new*t_use",
              "ref": 36000,
              "note": "10 W×3600 s=36000 J。"
            },
            {
              "type": "numeric",
              "scenario": "节能设备二",
              "expr": "P_new*t_use",
              "ref": 180000,
              "note": "25 W×7200 s=180000 J。"
            },
            {
              "type": "direction",
              "scenario": "节能灯具一",
              "var": "P_new",
              "lo": 0,
              "hi": 1000,
              "expr": "P_new*t_use",
              "expect": "up",
              "note": "使用时间固定时，新设备功率越大，耗电量越多。"
            },
            {
              "type": "scan",
              "scenario": "节能灯具一",
