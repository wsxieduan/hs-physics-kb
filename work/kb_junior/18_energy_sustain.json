            },
            {
              "type": "direction",
              "scenario": "节能灯具一",
              "var": "t_use",
              "lo": 0,
              "hi": 100000,
              "expr": "P_old*t_use",
              "expect": "up",
              "note": "旧设备功率固定时，使用时间越长，耗电量越多。"
