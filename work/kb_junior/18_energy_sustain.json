          "E": 0.4,
          "P_old": 0.1,
          "P_new": 0.04,
          "E_save": 0.6
        }
      },
      "formulas": [
        {
          "name": "能量输入与各输出的平衡",
          "expr": "E_in = E_use+E_loss",
          "when": "按给定系统边界统计全部有用输出与损耗，能量单位一致。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "高效电机",
              "expr": "E_use+E_loss",
              "ref": 100,
              "note": "80 J 有用输出+20 J 其他转化=100 J 输入。"
            },
            {
              "type": "numeric",
              "scenario": "发电装置",
              "expr": "E_use+E_loss",
              "ref": 100,
              "note": "60 J 有用输出+40 J 其他转化=100 J 输入。"
            },
            {
              "type": "scan",
              "scenario": "高效电机",
              "var": "E_use",
              "lo": 0,
              "hi": 1000,
              "note": "扫描非负有用输出，按能量账目计算输入。"
            },
            {
              "type": "consistency",
              "scenario": "高效电机",
              "with": "sustain-02|能量输入与各输出的平衡",
              "with_expr": "E_in",
              "target": "设备输入的能量",
              "note": "直接求本公式输出，与情境中另列的E_in设计基准核对；数据是设计示例，不是实测。用于核对定义、反算或边界值，不宣称不同物理原理互证。",
              "verification_kind": "独立设计情境数据核对"
            }
          ]
        },
        {
          "name": "能量利用效率",
          "expr": "eta = E_use/E_in",
