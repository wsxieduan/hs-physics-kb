              "expr": "E_old-E_new",
              "ref": 540000,
              "note": "720000 J−180000 J=540000 J。"
            },
            {
              "type": "direction",
              "scenario": "节能灯具一",
              "var": "E_old",
              "lo": 0,
              "hi": 1000000,
              "expr": "E_old-E_new",
              "expect": "up",
