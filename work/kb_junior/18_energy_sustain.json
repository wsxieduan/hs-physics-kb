{
  "chapter": "能源与可持续发展",
  "order": 18,
  "intro": "用能耗估算和能量转化效率解释节能选择；同时区分可再生能源与不可再生能源，强调能源利用的环境影响。",
  "points": [
    {
      "id": "sustain-01",
      "title": "能源利用与社会发展中的耗电估算",
      "level": "基础",
      "definition": "能源利用支撑照明、交通、生产和现代生活。对电器而言，在功率近似稳定时，消耗的电能与功率和使用时间有关；用电能表记录的千瓦时可以直接用于生活中的用电估算。",
      "meaning": "社会发展会带来更多能源需求，因此既要保证合理用能，也要减少不必要的浪费。比较同一项用电服务的耗电量时，应确认功率和使用时间的单位一致；当功率用 kW、时间用 h 时，乘积直接得到 kWh。该关系只计算用电量，不足以单独评价能源来源的环境影响或可持续性。",
      "symbols": {
        "P": {
          "desc": "用电器的工作功率",
          "unit": "kW"
        },
        "t": {
          "desc": "用电时间",
          "unit": "h"
        },
        "E": {
          "desc": "消耗的电能",
          "unit": "kWh"
        }
      },
      "scenarios": {
        "LED灯五小时": {
          "P": 0.01,
          "t": 5,
          "E": 0.05
        },
        "教室照明十小时": {
          "P": 0.04,
          "t": 10,
          "E": 0.4
        }
      },
      "formulas": [
        {
          "name": "功率和时间求耗电量",
          "expr": "E = P*t",
          "when": "P 用 kW、t 用 h，所得电能 E 用 kWh。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "LED灯五小时",
              "expr": "P*t",
              "ref": 0.05,
              "note": "0.01 kW×5 h=0.05 kWh。"
            },
            {
              "type": "numeric",
              "scenario": "教室照明十小时",
              "expr": "P*t",
              "ref": 0.4,
              "note": "0.04 kW×10 h=0.4 kWh。"
            },
            {
              "type": "direction",
              "scenario": "LED灯五小时",
              "var": "t",
              "lo": 0,
              "hi": 100,
              "expr": "P*t",
              "expect": "up",
              "note": "功率固定时，使用时间越长，耗电量越多。"
            },
            {
              "type": "scan",
              "scenario": "LED灯五小时",
              "var": "t",
              "lo": 0,
              "hi": 10000,
              "note": "扫描非负使用时间，电能计算线性稳定。"
            },
            {
              "type": "consistency",
              "scenario": "LED灯五小时",
              "with": "sustain-01|功率和时间求耗电量",
              "with_expr": "E",
              "target": "消耗的电能",
              "note": "直接求本公式输出，与情境中另列的E设计基准核对；数据是设计示例，不是实测。用于核对定义、反算或边界值，不宣称不同物理原理互证。",
              "verification_kind": "独立设计情境数据核对",
              "tol": 5.000000000000001e-07
            }
          ]
        },
        {
          "name": "由耗电量和使用时间求平均功率",
          "expr": "P = E/t",
          "when": "电能 E 用 kWh、时间 t 用 h，所得平均功率 P 用 kW。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "LED灯五小时",
              "expr": "E/t",
              "ref": 0.01,
              "note": "0.05 kWh÷5 h=0.01 kW。"
            },
            {
              "type": "numeric",
              "scenario": "教室照明十小时",
              "expr": "E/t",
              "ref": 0.04,
              "note": "0.4 kWh÷10 h=0.04 kW。"
            },
            {
              "type": "direction",
              "scenario": "LED灯五小时",
              "var": "E",
              "lo": 0,
              "hi": 1,
              "expr": "E/t",
              "expect": "up",
              "note": "时间固定时，耗电量越多，平均功率越大。"
            },
            {
              "type": "scan",
              "scenario": "LED灯五小时",
              "var": "t",
              "lo": 0.01,
              "hi": 10000,
              "note": "扫描正时间，反算平均功率时不除以零。"
            },
            {
              "type": "consistency",
              "scenario": "LED灯五小时",
              "with": "sustain-01|由耗电量和使用时间求平均功率",
              "with_expr": "P",
              "target": "用电器的工作功率",
              "note": "直接求本公式输出，与情境中另列的P设计基准核对；数据是设计示例，不是实测。用于核对定义、反算或边界值，不宣称不同物理原理互证。",
              "verification_kind": "独立设计情境数据核对",
              "tol": 1.0000000000000001e-07
            }
          ]
        }
      ],
      "derivation": [
        "读取用电器铭牌或题目给出的工作功率。",
        "把功率统一成 kW、时间统一成 h。",
        "功率乘以使用时间，得到以 kWh 表示的电能。",
        "同一类服务下比较不同设备或不同时长的耗电量，避免只凭额定功率判断。"
      ],
      "errors": [
        {
          "wrong": "把耗电量写成功率除以使用时间。",
          "wrong_expr": "E = P/t",
          "why": "耗电量等于功率乘以时间；功率再除以时间会得到功率变化率，不是电能。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "kind": "dimension",
            "target": "E = P/t",
            "lhs_dim": "M·L^2·T^-2",
            "rhs_dim": "M·L^2·T^-4",
            "expect": "mismatch",
            "note": "实际量纲检查得到等号左边为M·L^2·T^-2、右边为M·L^2·T^-4；两边不是同一物理量，因此该等式不成立。"
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "LED灯功率为 0.01 kW、使用 5 h，却把耗电量写成 0.002 kWh。",
          "wrong_expr": "E = P/t",
          "why": "0.01 kW×5 h=0.05 kWh；除法结果不仅数值错误，单位也不能表示耗电量。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "kind": "dimension",
            "target": "E = P/t",
            "expect": "mismatch",
            "lhs_dim": "M·L^2·T^-2",
            "rhs_dim": "M·L^2·T^-4",
            "note": "正式引擎验证量纲不一致；不计作同量纲错误数值实测。"
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "只看额定功率较小，就断定设备一定更节能而不看使用时长。",
          "why": "耗电量还取决于使用时间；小功率设备长时间运行也可能耗电更多。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "把5 h误作5 min换成小时。",
          "wrong_expr": "E = P*t/60",
          "why": "时间实际5 h，能耗0.05 kWh；误作5 min才需要除60，结果小60倍。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "LED灯五小时",
            "expr": "P*t/60",
            "ref": 0.05,
            "tol": 5e-08
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "一盏功率为 0.01 kW 的 LED 灯连续使用 5 h，求消耗的电能。",
        "solution": [
          "E=P*t=0.01×5=0.05 kWh。",
          "此结果只描述这段时间的用电量，不代表整套能源方案的环境影响。"
        ],
        "answer": "消耗电能为 0.05 kWh。"
      },
      "prereq": [
        "power-01",
        "power-02"
      ],
      "next": [
        "sustain-03"
      ],
      "tags": [
        "节能",
        "电能",
        "功率",
        "使用时间",
        "千瓦时"
      ],
      "core": [
        {
          "title": "能源利用与社会发展",
          "text": "能源是可提供能量的资源。煤、石油、天然气为化石能源，按形成速度通常属不可再生；太阳、风、水等属可再生。一次能源来自自然界，电能等二次能源通常需转化制得。不同方案要比较供应、效率、污染、资源和安全，不能把“电器没有排烟”当全链条零排放。"
        },
        {
          "title": "本章素养回顾（原创任务）",
          "text": "选择本章一个现象，写出结论、成立条件和证据；用另一条本章规律复核解释是否矛盾。指出一次测量或模型的局限，并说明还需什么证据；数值通过不替代概念辨析。"
        }
      ],
      "learning_scope": "初中"
    },
    {
      "id": "sustain-03",
      "title": "核能",
      "level": "基础",
      "definition": "核能储存在原子核内部，核裂变和核聚变过程都能释放核能。核电站主要利用核裂变释放的能量加热介质，再通过汽轮机和发电机把能量逐步转化为电能；初中阶段认识其原理链条和安全、环境影响，不要求使用质能方程计算。",
      "meaning": "核电站不是把核能直接变成电能：能量会经历核能、内能、机械能和电能等形式的转化。若已知电站对外输出的电功率，可以用功率乘运行时间估算一段时间输出的电能；这是通用电功率关系的应用，不是核反应释放能量的预测公式。讨论核能时还应区分运行排放、核废料管理和事故风险等不同问题。",
      "symbols": {
        "P_el": {
          "desc": "核电站对外输出的电功率",
          "unit": "W"
        },
        "t_n": {
          "desc": "持续输出的时间",
          "unit": "s"
        },
        "E_el": {
          "desc": "这段时间输出的电能",
          "unit": "J"
        }
      },
      "scenarios": {
        "核电站一小时输出": {
          "P_el": 1000000000,
          "t_n": 3600,
          "E_el": 3600000000000
        },
        "核电站两小时输出": {
          "P_el": 500000000,
          "t_n": 7200,
          "E_el": 3600000000000
        }
      },
      "formulas": [
        {
          "name": "由电功率估算核电站输出电能",
          "expr": "E_el = P_el*t_n",
          "when": "仅作已知电学或能量数据的应用，不验证本卡定性规律。对外电功率在所计时间内近似稳定，时间用 s、电功率用 W。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "核电站一小时输出",
              "expr": "P_el*t_n",
              "ref": 3600000000000,
              "note": "1.0×10^9 W×3600 s=3.6×10^12 J。"
            },
            {
              "type": "numeric",
              "scenario": "核电站两小时输出",
              "expr": "P_el*t_n",
              "ref": 3600000000000,
              "note": "5.0×10^8 W×7200 s=3.6×10^12 J。"
            },
            {
              "type": "direction",
              "scenario": "核电站一小时输出",
              "var": "t_n",
              "lo": 0,
              "hi": 100000,
              "expr": "P_el*t_n",
              "expect": "up",
              "note": "输出功率固定时，运行时间越长，累计输出电能越多。"
            },
            {
              "type": "scan",
              "scenario": "核电站一小时输出",
              "var": "t_n",
              "lo": 0,
              "hi": 10000000,
              "note": "扫描非负运行时间，输出电能保持有限。"
            },
            {
              "type": "consistency",
              "scenario": "核电站一小时输出",
              "with": "sustain-03|由电功率估算核电站输出电能",
              "with_expr": "E_el",
              "target": "这段时间输出的电能",
              "note": "直接求本公式输出，与情境中另列的E_el设计基准核对；数据是设计示例，不是实测。用于核对定义、反算或边界值，不宣称不同物理原理互证。",
              "verification_kind": "独立设计情境数据核对"
            }
          ]
        },
        {
          "name": "由输出电能和时间求平均电功率",
          "expr": "P_el = E_el/t_n",
          "when": "仅作已知电学或能量数据的应用，不验证本卡定性规律。输出电能和时间对应同一过程，通电时间 大于 0。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "核电站一小时输出",
              "expr": "E_el/t_n",
              "ref": 1000000000,
              "note": "3.6×10^12 J÷3600 s=1.0×10^9 W。"
            },
            {
              "type": "numeric",
              "scenario": "核电站两小时输出",
              "expr": "E_el/t_n",
              "ref": 500000000,
              "note": "3.6×10^12 J÷7200 s=5.0×10^8 W。"
            },
            {
              "type": "direction",
              "scenario": "核电站一小时输出",
              "var": "E_el",
              "lo": 0,
              "hi": 10000000000000,
              "expr": "E_el/t_n",
              "expect": "up",
              "note": "时间固定时，输出电能越多，平均电功率越大。"
            },
            {
              "type": "scan",
              "scenario": "核电站一小时输出",
              "var": "t_n",
              "lo": 0.1,
              "hi": 10000000,
              "note": "扫描正时间，反算功率时不会除以零。"
            }
          ]
        }
      ],
      "derivation": [
        "核裂变释放的核能先转化为内能，再驱动汽轮机和发电机。",
        "电站输出电功率表示单位时间输出的电能。",
        "当功率近似稳定时，用输出功率乘运行时间估算输出电能。",
        "这一估算只计算已知的电功率输出，不从反应物质量推算核反应能量。"
      ],
      "errors": [
        {
          "wrong": "把核能说成在电站内一步直接变成电能。",
          "why": "核电站先通过裂变加热介质，再驱动汽轮机和发电机，能量经历多个转化环节。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "把输出电能写成输出功率除以运行时间。",
          "wrong_expr": "E_el = P_el/t_n",
          "why": "输出电能是功率对时间的累积，应将功率乘运行时间；相除得到的单位也不再是焦耳。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "kind": "dimension",
            "target": "E_el = P_el/t_n",
            "lhs_dim": "M·L^2·T^-2",
            "rhs_dim": "M·L^2·T^-4",
            "expect": "mismatch",
            "note": "实际量纲检查得到等号左边为M·L^2·T^-2、右边为M·L^2·T^-4；两边不是同一物理量，因此该等式不成立。"
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "核电站 1.0×10^9 W 运行 3600 s，误将时间除以 3600 再代入。",
          "wrong_expr": "E_el = P_el*(t_n/3600)",
          "why": "题目给出的运行时间已是秒，重复除以 3600 会把应有输出电能缩小 3600 倍。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "核电站一小时输出",
            "expr": "P_el*(t_n/3600)",
            "ref": 3600000000000
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "某发电装置对外输出功率为 1.0×10^9 W，若连续输出 3600 s，估算输出电能。",
        "solution": [
          "E_el=P_el*t_n=1.0×10^9×3600=3.6×10^12 J。",
          "这是输出电能估算，不能据此倒推核燃料释放能量。"
        ],
        "answer": "输出电能约为 3.6×10^12 J。"
      },
      "prereq": [
        "power-02",
        "energy-04"
      ],
      "next": [
        "sustain-04"
      ],
      "tags": [
        "核能",
        "核裂变",
        "核聚变",
        "核电站",
        "能量转化",
        "运行风险"
      ],
      "core": [
        {
          "title": "核能",
          "text": "裂变把重原子核分成较轻核，聚变使轻核结合成较重核，在相应反应条件下可释放能量。核电站使用受控裂变链式反应加热工质，经汽轮机、发电机转为电能；太阳能量主要来自核聚变。核废料、辐射防护和事故风险都需专业管理，不把核能等同化学燃烧。"
        }
      ],
      "learning_scope": "初中"
    },
    {
      "id": "sustain-04",
      "title": "太阳能",
      "level": "基础",
      "definition": "太阳能来自太阳辐射，属于可再生能源，可用于光热和光伏等技术。太阳能热水器把辐射能转移给水的内能；太阳能电池则把部分光能转化为电能。设备的实际利用还受天气、面积、朝向和转换效率影响。",
      "meaning": "估算太阳能热水器把水加热所需能量时，可把水看作吸收热量的物体，用水的比热容、质量和升高的温度计算吸收的热量。该关系只描述水获得的热量，不等于太阳辐射总能量；由于装置存在反射、散热等损失，太阳提供的能量通常更大。太阳能可再生，但并非任何时间和地点都能稳定提供相同功率。",
      "symbols": {
        "c_water": {
          "desc": "水的比热容",
          "unit": "J/kg/℃"
        },
        "m_water": {
          "desc": "被加热水的质量",
          "unit": "kg"
        },
        "dT": {
          "desc": "水升高的温度",
          "unit": "℃"
        },
        "Q_water": {
          "desc": "水吸收的热量",
          "unit": "J"
        }
      },
      "scenarios": {
        "太阳能热水器一": {
          "c_water": 4200,
          "m_water": 0.2,
          "dT": 15,
          "Q_water": 12600
        },
        "太阳能热水器二": {
          "c_water": 4200,
          "m_water": 0.5,
          "dT": 20,
          "Q_water": 42000
        }
      },
      "formulas": [
        {
          "name": "估算水吸收的热量",
          "expr": "Q_water = c_water*m_water*dT",
          "when": "只计算水吸收的热量，忽略容器热容和散热；水的比热容用 J/kg/℃。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "太阳能热水器一",
              "expr": "c_water*m_water*dT",
              "ref": 12600,
              "note": "4200×0.2×15=12600 J。"
            },
            {
              "type": "numeric",
              "scenario": "太阳能热水器二",
              "expr": "c_water*m_water*dT",
              "ref": 42000,
              "note": "4200×0.5×20=42000 J。"
            },
            {
              "type": "direction",
