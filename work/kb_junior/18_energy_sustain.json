    {
      "id": "sustain-02",
      "title": "能量转化的基本规律",
      "level": "基础",
      "definition": "能量可以从一种形式转化为另一种形式，也可以在物体之间传递；在转化和传递过程中，能量总量保持不变。实际装置中一部分能量会转化为不便利用的形式，能量利用效率表示有用输出占输入的比例。",
      "meaning": "分析能量转化时要先划定研究对象和过程，再把输入、有用输出以及转化到环境中的其他能量分别列出。能量守恒不表示每一部分能量都同样容易利用；效率是有用能量与输入能量之比，不能超过 100%。本节的能量账目关系可用于检查转换过程是否漏项，效率关系用于比较装置利用输入能量的程度。",
      "symbols": {
        "E_in": {
          "desc": "设备输入的能量",
          "unit": "J"
        },
        "E_use": {
          "desc": "转化得到的有用能量",
          "unit": "J"
        },
        "E_loss": {
          "desc": "未成为目标有用输出的能量",
          "unit": "J"
        },
        "eta": {
          "desc": "能量利用效率，以小数表示",
          "unit": "1"
        },
        "P": {
          "desc": "用电器功率",
          "unit": "kW"
        },
        "t": {
          "desc": "使用时间",
          "unit": "h"
        },
        "E": {
          "desc": "使用期间消耗的电能",
          "unit": "kWh"
        },
        "P_old": {
          "desc": "原用电器功率",
          "unit": "kW"
        },
        "P_new": {
          "desc": "替换后用电器功率",
          "unit": "kW"
        },
        "E_save": {
          "desc": "替换后节省的电能",
          "unit": "kWh"
        }
      },
      "scenarios": {
        "高效电机": {
          "E_in": 100,
          "E_use": 80,
          "E_loss": 20,
          "eta": 0.8
        },
        "发电装置": {
          "E_in": 100,
          "E_use": 60,
          "E_loss": 40,
          "eta": 0.6
        },
        "LED灯五小时": {
          "P": 0.01,
          "t": 5,
          "E": 0.05,
          "P_old": 0.06,
          "P_new": 0.01,
