            }
          ]
        }
      ],
      "derivation": [
        "给能量转换过程划定系统边界，统计输入能量。",
        "把输出分成完成目标的有用能量与其他转化能量。",
        "能量守恒要求输入与全部输出相等。",
        "有用输出除以输入能量得到效率，可乘 100% 表示百分数。"
      ],
      "errors": [
        {
          "wrong": "把能量利用效率写成输入能量除以有用能量。",
          "wrong_expr": "eta = E_in/E_use",
          "why": "效率是有用输出占输入的比例；高效电机情境中为 80/100=0.8，而不是 1.25。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "高效电机",
            "expr": "E_in/E_use",
            "ref": 0.8
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "认为可再生能源没有任何环境影响，或认为能量损耗意味着能量消失。",
          "why": "可再生能源的利用仍可能影响生态和土地；损耗能量通常转化为不易利用的热、声等形式，并未违反能量守恒。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "一台装置输入 100 J 能量，其中 80 J 转化为有用输出，求效率和其他能量。",
        "solution": [
          "效率 eta=80/100=0.8=80%。",
          "其他转化能量为 100-80=20 J。"
        ],
        "answer": "效率为 80%，其他能量为 20 J。"
      },
      "prereq": [
        "energy-01",
        "machine-03"
      ],
      "next": [
        "sustain-05"
      ],
      "tags": [
        "可再生能源",
        "不可再生能源",
        "能量守恒",
        "能源效率",
        "可持续发展"
      ],
      "core": [
        {
          "title": "能量转化的基本规律",
          "text": "能量可转化、可转移，总量守恒；转移和转化具有方向性，分散到环境的内能通常难以全部回收。节约能源的原因是易用能资源和利用条件有限，不是能量会从宇宙消失。效率先约定有用目标和系统边界，不能超过100%，不同装置效率要在可比边界下比较。"
        }
      ],
      "learning_scope": "初中"
    },
    {
      "id": "sustain-05",
      "title": "能源与可持续发展",
      "level": "基础",
      "definition": "能源与可持续发展要求兼顾当前生产生活需要、资源长期供应和生态环境保护。节约能源、提高利用效率、发展可再生能源并减少污染排放，都是降低能源系统负担的途径；不同能源方案还要结合场地、稳定性和安全条件比较。",
      "meaning": "比较节能措施时，先确保新旧方案提供相同的照明、出行或生产服务，再比较同一使用时长内的耗电量差。功率较低并不自动意味着更可持续，还要考虑设备寿命、发电结构、材料和回收等因素。本条用新旧设备的耗电量差做一个边界清楚的定量例子，不把单次能耗计算冒充完整的生命周期评价。",
      "symbols": {
        "P_old": {
          "desc": "旧设备功率",
          "unit": "W"
        },
        "P_new": {
          "desc": "新设备功率",
          "unit": "W"
        },
        "t_use": {
          "desc": "两种设备提供相同服务的使用时间",
          "unit": "s"
        },
        "E_old": {
          "desc": "旧设备在该时段消耗的电能",
          "unit": "J"
        },
        "E_new": {
          "desc": "新设备在该时段消耗的电能",
          "unit": "J"
        },
        "E_save": {
          "desc": "新设备相对旧设备减少的耗电量",
          "unit": "J"
        }
      },
      "scenarios": {
        "节能灯具一": {
          "P_old": 60,
          "P_new": 10,
          "t_use": 3600,
          "E_old": 216000,
          "E_new": 36000,
          "E_save": 180000
        },
        "节能设备二": {
          "P_old": 100,
          "P_new": 25,
          "t_use": 7200,
          "E_old": 720000,
          "E_new": 180000,
          "E_save": 540000
        }
      },
      "formulas": [
        {
          "name": "计算旧设备在相同服务时段的耗电量",
          "expr": "E_old = P_old*t_use",
          "when": "功率近似稳定，时间用 s、功率用 W，所得能量为 J。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "节能灯具一",
