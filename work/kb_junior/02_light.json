          "checks": [
            {
              "type": "numeric",
              "scenario": "光传播1微秒",
              "expr": "s/t",
              "ref": 300000000,
              "note": "300 m ÷ 0.000001 s = 3.0×10^8 m/s。"
            },
            {
              "type": "numeric",
              "scenario": "光传播2微秒",
              "expr": "s/t",
              "ref": 300000000,
              "note": "600 m ÷ 0.000002 s 仍约为 3.0×10^8 m/s。"
