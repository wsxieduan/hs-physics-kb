      "core": [
        {
          "title": "光的色彩",
          "text": "光源自身发光，月亮反射太阳光而非光源。白光经棱镜色散，说明它由多种色光组成；色光三原色为红、绿、蓝，适当叠加可成白光，颜料混合不是同一规律。透明物体颜色取决于主要透过的色光，不透明物体颜色取决于主要反射的色光；红物体在只有蓝光照射时可能很暗，不能只按物体名称断言颜色。"
        },
        {
          "title": "本章素养回顾（原创任务）",
          "text": "选择本章一个现象，写出结论、成立条件和证据；用另一条本章规律复核解释是否矛盾。指出一次测量或模型的局限，并说明还需什么证据；数值通过不替代概念辨析。"
        }
      ],
      "learning_scope": "初中主线；公式含拓展"
    },
    {
      "id": "light-01",
      "title": "光的直线传播",
      "level": "基础",
      "definition": "光在同种均匀介质中沿直线传播；从一种介质进入另一种介质时，传播方向可能改变。真空中的光速约为每秒三亿米，空气中的光速可近似取这一数值。",
      "meaning": "影子的形成、小孔成像和日食月食都能用光沿直线传播解释。计算传播距离时，要区分单程和往返路程，并让速度、时间和距离采用相容单位。光速关系只能计算传播过程，不能单独决定反射或折射方向。",
      "symbols": {
        "s": {
          "desc": "光传播的路程",
          "unit": "m"
        },
        "c": {
          "desc": "光传播速度，空气中近似取真空光速",
          "unit": "m/s"
        },
        "t": {
          "desc": "光传播所用时间",
          "unit": "s"
        }
      },
      "scenarios": {
        "光传播1微秒": {
          "s": 300,
          "c": 300000000,
          "t": 1e-06
        },
