{
  "chapter": "光现象",
  "order": 2,
  "intro": "按苏科版2024目录将光的色彩、直线传播、平面镜和光的反射分为四个可查知识点；拓展关系明确标注，不替代教材实验结论。",
  "points": [
    {
      "id": "light-04",
      "title": "光的色彩",
      "level": "拓展",
      "definition": "白光由多种色光组成；不同色光在真空中的波速相同，但频率和波长不同。按本知识点的拓展关系，光速、频率与波长可互相换算，色散现象则用来观察白光分解出的色光。",
      "meaning": "教材重点是观察色散、认识不同色光及其混合现象；颜色不能用亮度替代。为把观察与可测量量联系起来，这里补充真空电磁波的波速关系：固定光速时，波长越长，频率越低。该换算属于拓展工具，不代替色散实验，也不意味着所有介质中的光速都相同。",
      "symbols": {
        "f": {
          "desc": "光波频率",
          "unit": "Hz"
        },
        "lambda": {
          "desc": "光波波长",
          "unit": "m"
        },
        "c": {
          "desc": "真空中的光速",
          "unit": "m/s"
        },
        "s": {
          "desc": "真空中光传播路程",
          "unit": "m"
        },
        "t": {
          "desc": "传播时间",
          "unit": "s"
        }
      },
      "scenarios": {
        "红光近似值": {
          "f": 400000000000000,
          "lambda": 7.5e-07,
          "c": 300000000,
          "s": 300,
          "t": 1e-06
        },
        "紫光近似值": {
          "f": 750000000000000,
          "lambda": 4e-07,
          "c": 300000000,
          "s": 600,
          "t": 2e-06
        }
      },
      "formulas": [
        {
          "name": "由真空光速和波长求频率",
          "expr": "f = c/lambda",
          "when": "拓展计算，非本卡初中必背主线。用于真空或可近似看作真空的光传播；光速 c、波长 lambda 使用 m/s、m。此关系用于色光的定量拓展，不是判断颜色的唯一依据。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "红光近似值",
              "expr": "c/lambda",
              "ref": 400000000000000,
              "note": "约 3.0×10^8 m/s ÷ 7.5×10^-7 m = 4.0×10^14 Hz。"
            },
            {
              "type": "numeric",
              "scenario": "紫光近似值",
              "expr": "c/lambda",
              "ref": 750000000000000,
              "note": "约 3.0×10^8 m/s ÷ 4.0×10^-7 m = 7.5×10^14 Hz。"
            },
            {
              "type": "direction",
              "scenario": "红光近似值",
              "var": "lambda",
              "lo": 4e-07,
              "hi": 8e-07,
              "expr": "c/lambda",
              "expect": "down",
              "note": "在光速不变时，波长增大，频率减小。"
            },
            {
              "type": "scan",
              "scenario": "红光近似值",
              "var": "lambda",
              "lo": 4e-07,
              "hi": 8e-07,
              "note": "扫描可见光附近正波长，频率保持为有限正值。"
            },
            {
              "type": "consistency",
              "scenario": "红光近似值",
              "with": "light-04|由真空光速和波长求频率",
              "with_expr": "s/(t*lambda)",
              "target": "光波频率",
              "note": "本公式直接求f；参考端显式关系为s/(t*lambda)。两端使用同一情境和阶段，只核对该关系；with字段仅定位来源，不代表调用另一条被覆盖的公式。",
              "verification_kind": "独立关系核对"
            }
          ]
        }
      ],
      "derivation": [
        "波在一个周期内传播一个波长，因此波速等于波长乘以每秒振动次数。",
        "频率关系 c=lambda*f 两边同除以波长，得到 f=c/lambda。",
        "代入前统一单位：波长用 m、频率用 Hz，乘积的单位为 m/s。"
      ],
      "errors": [
        {
          "wrong": "把频率误算为波速乘波长，混淆相除关系。",
          "wrong_expr": "f = c*lambda",
          "why": "频率应为波速除以波长；相乘得到的单位为m²/s，不是Hz。红光示例乘积为225，正确频率为4×10¹⁴ Hz。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "kind": "dimension",
            "target": "f = c*lambda",
            "expect": "mismatch",
            "lhs_dim": "T^-1",
            "rhs_dim": "L^2·T^-1",
            "note": "正式引擎验证量纲不一致；不计作同量纲错误数值实测。"
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "认为白光本身只有一种颜色，或把色光混合与颜料混合规律混为一谈。",
          "why": "棱镜色散可观察到白光分解出的多种色光；色光的叠加与颜料混合不是同一过程。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "把750 nm错误换为750 μm再求频率。",
          "wrong_expr": "f = c/(1000*lambda)",
          "why": "750 nm应7.5×10⁻⁷ m；误换为750 μm使波长大千倍、频率小千倍。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "红光近似值",
            "expr": "c/(1000*lambda)",
            "ref": 400000000000000.0,
            "tol": 1e-06
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "某单色光波长约为 6.0×10^-7 m，取真空光速 3.0×10^8 m/s，估算其频率。",
        "solution": [
          "辨认所求量是频率，使用 f=c/lambda。",
          "代入 f=3.0×10^8÷6.0×10^-7=5.0×10^14 Hz。"
        ],
        "answer": "频率约为 5.0×10^14 Hz。"
      },
