      "core": [
        {
          "title": "光的直线传播",
          "text": "成立条件是同种、均匀的介质。小孔成像是倒立的实像，形状由物体决定，孔的形状主要影响亮度与清晰度；影子是光被遮挡形成的暗区，不是镜像。日食时月球位于太阳与地球之间；月食时地球位于太阳与月球之间。解释先画光路，不把所有成像归为反射。"
        }
      ],
      "learning_scope": "初中"
