      },
      "formulas": [
        {
          "name": "由电压和电流求电阻",
          "expr": "R = U/I",
          "when": "导体两端电压 U 和通过电流 I 来自同一测量状态，I 不为零。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "三欧导体",
              "expr": "U/I",
              "ref": 3,
              "note": "6 V÷2 A=3 Ω。"
            },
            {
              "type": "numeric",
              "scenario": "六欧导体",
              "expr": "U/I",
              "ref": 6,
              "note": "12 V÷2 A=6 Ω。"
            },
            {
              "type": "scan",
              "scenario": "三欧导体",
              "var": "I",
              "lo": 0.001,
              "hi": 20,
              "note": "扫描正电流读数，反算电阻有限。"
            },
            {
              "type": "consistency",
              "scenario": "串联电阻总值测量",
              "with": "ohm-01|由电压和电流求电阻",
              "with_expr": "R1+R2",
              "target": "导体电阻",
              "note": "本公式直接求R；参考端显式关系为R1+R2。两端使用同一情境和阶段，只核对该关系；with字段仅定位来源，不代表调用另一条被覆盖的公式。",
              "verification_kind": "独立关系核对"
            }
          ]
        }
      ],
      "derivation": [
        "在温度等条件不变时，通过导体的电流随两端电压增大而增大。",
        "电阻越大，对电流的阻碍作用越明显，电流越小。",
        "综合两种变化关系得到 I=U/R。",
        "由测得的 U 与 I 可变形求 R=U/I。"
      ],
      "errors": [
        {
          "wrong": "把欧姆定律误写成电流等于电阻除以电压。",
          "wrong_expr": "I = R/U",
          "why": "欧姆定律应当用电压除以电阻来求电流；把电阻除以电压不仅关系倒置，所得量纲也不是安培。",
          "caught_by": "量纲一致性",
          "trap_test": {
            "kind": "dimension",
            "target": "I = R/U",
            "lhs_dim": "I",
            "rhs_dim": "I^-1",
            "expect": "mismatch",
            "note": "实际量纲检查得到等号左边为I、右边为I^-1；两边不是同一物理量，因此该等式不成立。"
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "把 3 kΩ 的数值 3 直接当成 3 Ω 代入，漏掉千欧到欧姆的 1000 倍换算。",
          "wrong_expr": "I = U/Rk",
          "why": "6 V 接在 3 kΩ 电阻上，电流应为 0.002 A；把数值 3 当作 Ω 会错误得到 2 A。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "千欧换算误区",
            "expr": "U/Rk",
            "ref": 0.002
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "不说明条件变化就认为电压改变会使导体电阻按比例改变。",
          "why": "电阻由导体材料、长度、横截面积和温度等因素决定；欧姆定律的 U/I 比值在相同条件下描述电阻。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        }
      ],
      "example": {
        "stem": "某导体两端电压 6 V，通过电流 2 A，求电阻。",
        "solution": [
          "R=U/I=6/2=3 Ω。",
          "欧姆定律适用于导体条件不变的测量状态。"
        ],
        "answer": "电阻为 3 Ω。"
      },
      "prereq": [
        "circuit-01",
        "circuit-02"
      ],
      "next": [
