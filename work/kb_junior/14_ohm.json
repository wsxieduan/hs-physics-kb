  "order": 14,
  "intro": "按苏科版2024目录拆分电阻、变阻器、欧姆定律和欧姆定律应用；变阻器接入长度、滑片和串并联条件均明确说明。",
  "points": [
    {
      "id": "ohm-01",
      "title": "电阻",
      "level": "基础",
      "definition": "电阻表示导体对电流的阻碍作用，单位为欧姆。对符合欧姆定律的导体，在温度等条件不变时，可用导体两端电压与通过电流的比值测量电阻。",
      "meaning": "电阻大小与导体材料、长度、横截面积和温度等因素有关；同一导体不能因为电压或电流变大就说电阻一定改变。测电阻时应使用电压表并联、电流表串联，再用 R=U/I 计算。欧姆定律适用条件要明确，灯丝温度改变时电阻也会改变。",
      "symbols": {
        "U": {
          "desc": "导体两端电压",
          "unit": "V"
        },
        "I": {
          "desc": "通过导体的电流",
          "unit": "A"
        },
        "R": {
          "desc": "导体电阻",
          "unit": "Ω"
        },
        "Rk": {
          "desc": "以 kΩ 表示的电阻数值",
          "unit": "kΩ"
        },
        "R1": {
          "desc": "第一只电阻",
          "unit": "Ω"
        },
        "R2": {
          "desc": "第二只电阻",
          "unit": "Ω"
