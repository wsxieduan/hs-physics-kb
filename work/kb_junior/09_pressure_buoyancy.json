          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "窄底物体",
            "expr": "F/(S_cm/100)",
            "ref": 5000
          },
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          }
        },
        {
          "wrong": "认为受力面积越大，压力固定时压强也越大。",
          "why": "同一压力分摊到更大的受力面积上，单位面积承担的压力会减小，因此压强减小；压力和压强不能混为一个量。",
          "caught_by": "人工审核",
          "diagnostic": {
            "style": "物理结论与步骤辨析"
          },
          "automation_review": {
            "status": "指定反例已补验；原人工审核标签保留",
            "basis": "压力固定100 N，面积从0.02 m²增加到0.04 m²，压强5000 Pa降到2500 Pa；错误按面积同比增大预测10000 Pa。",
            "scenario": "固定压力宽底反例设计",
            "correct_expression": "p = F/S",
            "wrong_expression": "p_0*S/S_0",
            "correct_value": 2500,
            "wrong_value": 10000.0,
            "unit": "Pa",
            "wrong_status": "numeric_mismatch",
            "note": "这是原创设计反例，机器仅验证指定模型、数据及量纲；自然语言命题、学生认知与装置仍待教师确认。"
          }
        }
      ],
      "example": {
        "stem": "重 100 N 的物体对水平地面的受力面积为 0.02 m2，求压强。",
        "solution": [
          "物体静止且水平面支撑时，压力大小为 100 N。",
          "p=F/S=100/0.02=5000 Pa。"
        ],
        "answer": "压强为 5000 Pa。"
      },
      "prereq": [
        "force-01"
      ],
      "next": [
        "pressure-02"
      ],
      "tags": [
        "压强",
        "压力",
        "受力面积",
        "帕斯卡"
      ],
      "core": [
        {
          "title": "压力与压强",
          "text": "压力垂直接触面，大小不总等于重力；斜面、额外按压等情况须分析。海绵凹陷程度用于比较压力效果，控制压力比面积、控制面积比压力。宽背带、雪板增大受力面积以减小压强；尖刀刃减小受力面积以增大压强。1 cm²=0.0001 m²，面积换算须平方长度倍率。"
        },
        {
          "title": "本章素养回顾（原创任务）",
          "text": "选择本章一个现象，写出结论、成立条件和证据；用另一条本章规律复核解释是否矛盾。指出一次测量或模型的局限，并说明还需什么证据；数值通过不替代概念辨析。"
        }
      ],
      "evidence": [
        {
          "kind": "conversion",
          "value": 200,
          "from_unit": "cm²",
          "expected": 0.02,
          "to_unit": "m²",
          "note": "长度100倍率，面积平方为10000倍率。"
        }
      ],
      "learning_scope": "初中"
    },
    {
      "id": "pressure-02",
      "title": "液体的压强",
      "level": "基础",
      "definition": "液体内部向各个方向都有压强；同种液体中深度越大，压强越大。液体内部压强与液体密度、重力加速度和测点到液面的竖直深度有关，常用 p=rho*g*h 计算。",
      "meaning": "深度 h 从液面向下竖直测量，不是沿斜面或容器壁量出的距离。液体压强还会传向容器侧壁和底部；同一深度的压强与容器形状无关。利用压强求某一面积上的压力时再用 F=pS，避免把压强和压力混淆。",
      "symbols": {
        "p": {
          "desc": "液体内部压强",
          "unit": "Pa"
        },
        "rho": {
          "desc": "液体密度",
          "unit": "kg/m^3"
        },
        "g": {
          "desc": "当地重力加速度",
          "unit": "N/kg"
        },
        "h": {
          "desc": "测点到液面的竖直深度",
          "unit": "m"
        },
        "S": {
          "desc": "受液体压强作用的面积",
          "unit": "m2"
        },
        "F": {
          "desc": "该面积上液体压力",
          "unit": "N"
        }
      },
