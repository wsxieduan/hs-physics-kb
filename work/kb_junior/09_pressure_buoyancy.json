{
  "chapter": "压强和浮力",
  "order": 9,
  "intro": "按苏科版2024目录分为固体压强、液体压强、气体压强、浮力和浮沉判断；水银柱估算与静止液柱模型注明其适用条件。",
  "points": [
    {
      "id": "pressure-01",
      "title": "压强",
      "level": "基础",
      "definition": "压力是垂直作用在接触面上的力；压强表示单位面积上受到的压力，p=F/S。压力固定时受力面积越小，压强越大；比较不同情境时要先确认压力方向和接触面积。",
      "meaning": "压强能描述压力作用效果。计算固体压强时使用垂直接触面的压力和实际受力面积；不能把物体全部表面积当作受力面积。增大压力或减小受力面积通常会增大压强；单位 Pa 等于 N/m²。",
      "symbols": {
        "F": {
          "desc": "垂直接触面的压力",
          "unit": "N"
        },
        "S": {
          "desc": "受力面积",
          "unit": "m2"
        },
        "p": {
          "desc": "压强",
          "unit": "Pa"
        },
        "rho": {
          "desc": "液体密度",
          "unit": "kg/m^3"
        },
        "g": {
          "desc": "当地重力加速度",
          "unit": "N/kg"
        },
        "h": {
          "desc": "测点到液面的竖直深度",
          "unit": "m"
        },
        "S_cm": {
          "desc": "受力面积以平方厘米记录的数值",
          "unit": "cm2"
        },
        "p_0": {
          "unit": "Pa",
          "desc": "面积改变前的设计压强"
        },
        "S_0": {
          "unit": "m2",
          "desc": "面积改变前的设计受力面积"
        }
      },
      "scenarios": {
        "窄底物体": {
          "F": 100,
          "S": 0.02,
          "p": 5000,
          "S_cm": 200.0
        },
        "宽底物体": {
          "F": 200,
          "S": 0.04,
          "p": 5000,
          "S_cm": 400.0
        },
        "水下10厘米": {
          "p": 1000,
          "rho": 1000,
          "g": 10,
          "h": 0.1,
          "S": 0.01,
          "F": 10,
          "S_cm": 100.0
        },
        "水下20厘米": {
          "p": 2000,
          "rho": 1000,
          "g": 10,
          "h": 0.2,
          "S": 0.01,
          "F": 20,
          "S_cm": 100.0
        },
        "固定压力宽底反例设计": {
          "F": 100,
          "S": 0.04,
          "p": 2500,
          "S_cm": 400,
          "p_0": 5000,
          "S_0": 0.02
        }
      },
      "formulas": [
        {
          "name": "压力与受力面积求压强",
          "expr": "p = F/S",
          "when": "F 垂直接触面，F 用 N、S 用 m2，结果 p 用 Pa。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "窄底物体",
              "expr": "F/S",
              "ref": 5000,
              "note": "100 N÷0.02 m2=5000 Pa。"
            },
            {
              "type": "numeric",
              "scenario": "宽底物体",
              "expr": "F/S",
              "ref": 5000,
              "note": "200 N÷0.04 m2=5000 Pa。"
            },
            {
              "type": "direction",
              "scenario": "窄底物体",
              "var": "S",
              "lo": 0.01,
              "hi": 0.1,
              "expr": "F/S",
              "expect": "down",
              "note": "压力固定时，受力面积增大，压强减小。"
            },
            {
              "type": "scan",
              "scenario": "窄底物体",
              "var": "S",
              "lo": 0.001,
              "hi": 1,
              "note": "扫描正面积范围，检查除法计算稳定。"
            },
            {
              "type": "consistency",
              "scenario": "窄底物体",
