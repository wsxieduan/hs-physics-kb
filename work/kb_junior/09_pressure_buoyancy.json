            }
          ]
        },
        {
          "name": "由压强和面积求压力",
          "expr": "F = p*S",
          "when": "压力垂直作用于面积 S，压强 p 均匀。",
          "checks": [
            {
              "type": "numeric",
              "scenario": "窄底物体",
              "expr": "p*S",
              "ref": 100,
              "note": "5000 Pa×0.02 m2=100 N。"
            },
            {
              "type": "numeric",
              "scenario": "宽底物体",
              "expr": "p*S",
              "ref": 200,
              "note": "5000 Pa×0.04 m2=200 N。"
            },
            {
              "type": "scan",
              "scenario": "窄底物体",
              "var": "S",
              "lo": 0,
              "hi": 1,
              "note": "扫描非负面积，反算的压力数值有限。"
            }
          ]
        }
      ],
      "derivation": [
        "确定垂直作用于接触面的压力 F。",
        "测量承受压力的面积 S 并统一为 m2。",
        "把 F 除以 S 得压强 p；也可由 p 和 S 反算压力。"
      ],
      "errors": [
        {
          "wrong": "把压强写成压力乘以面积。",
          "wrong_expr": "p = F*S",
