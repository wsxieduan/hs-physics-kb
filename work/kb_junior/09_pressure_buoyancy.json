      "core": [
        {
          "title": "浮力与排开体积",
          "text": "浸在液体中的物体受向上浮力，液体上下表面对物体的压力差可解释其来源。浮力大小等于排开液体的重力，取决于液体密度和排开体积；部分浸入时排开体积小于物体总体积，完全浸没后在均匀液体中继续加深，浮力不因深度单独增大。物体和底部接触且底面无液体时，通常浮力模型需重新分析。"
        }
      ],
      "experiments": [
        {
          "title": "探究浮力大小的影响因素",
          "purpose": "研究排开体积和液体密度。",
          "apparatus": "测力计、物体、水与盐水、量筒、细线。",
          "variables": "同液改变浸入体积，体积相同改液体，完全浸没后改深度；观察称重差。",
          "steps": [
            "先在空气中读重力，浸液后读稳定拉力。",
            "用重力减拉力求浮力，逐步增加浸入体积。",
            "完全浸没后改深度，再保持体积换液体，分组比较。"
          ],
          "data": "设计示例（非实测）：空气中5 N、水中完全浸没3 N，浮力2 N；排水200 cm³按g=10也得2 N。",
          "conclusion": "浮力随排开体积或液体密度增大而增大；均匀液体全浸没后仅改深度一般不改变浮力。",
          "limits": "附着气泡、碰底碰壁、线未竖直影响测力；密度不同与体积不同不能同时改变后归因于一个因素。",
          "kind": "学生必做"
        }
      ],
      "learning_scope": "初中"
    },
    {
