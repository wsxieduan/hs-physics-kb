        },
        "漂浮木块": {
          "Fb": 20,
          "rho": 1000,
          "g": 10,
          "V": 0.002,
          "Gd": 20,
          "G": 20,
          "V_total": 0.004
        }
      },
      "formulas": [
        {
          "name": "流体密度和排开体积求浮力",
          "expr": "Fb = rho*g*V",
