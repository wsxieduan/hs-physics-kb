          "unit": "kg/m^3"
        },
        "g": {
          "desc": "当地重力加速度",
          "unit": "N/kg"
        },
        "V": {
          "desc": "物体排开液体的体积",
          "unit": "m^3"
        },
        "Gd": {
          "desc": "排开液体所受的重力",
          "unit": "N"
        },
        "G": {
          "desc": "物体所受重力",
          "unit": "N"
        },
        "V_total": {
          "desc": "物体总体积，部分浸入时大于排开体积",
          "unit": "m^3"
        }
      },
      "scenarios": {
