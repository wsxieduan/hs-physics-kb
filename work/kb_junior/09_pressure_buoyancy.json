      "core": [
        {
          "title": "液体压强",
          "text": "液体因重力与流动性对底、壁和内部各方向施压；静止同种液体同深度压强相同。深度是自由液面到测点的竖直距离，不是倾斜距离或液柱总长度。连通器中同种液体、自由液面压强相同且静止时，各液面高度相同；不满足条件时不能直接套用。"
        }
      ],
      "experiments": [
        {
          "title": "探究液体压强的影响因素",
          "purpose": "比较方向、深度、液体密度。",
          "apparatus": "液体压强计、橡皮膜探头、水、盐水和刻度尺。",
          "variables": "同液同深度改朝向；同液改深度；同深度改液体密度，观察U形管高度差。",
          "steps": [
            "检查密封，确认同压时两侧液面等高。",
            "同深度转探头，比较高度差；再增大深度。",
            "保持深度改用较高密度液体，比较高度差。"
          ],
          "data": "设计示例（非实测）：水中10 cm与20 cm高度差不同，若按g=10 N/kg则模型压强1000、2000 Pa。",
          "conclusion": "静止同种液体同深度各向压强相同；深度或液体密度较大时压强较大。",
          "limits": "橡皮膜漏气、残余压差、深度量错影响结论；U形管高度差表示压强差，不直接当探头深度。",
          "kind": "学生必做"
        }
      ],
      "learning_scope": "初中"
    },
