        },
        "五个半衰期": {
          "N_0": 800,
          "n_half": 5,
          "N": 25,
          "T_half": 5,
          "t": 25,
          "k_decay": 0.13862943611198905
        }
      },
      "formulas": [
        {
          "name": "半衰期个数与时间的关系",
          "expr": "n_half = t/T_half",
          "when": "把实际时间换算成「过了几个半衰期」，便于按整数倍心算",
          "checks": [
