    {
      "id": "nuc-03",
      "title": "半衰期",
      "level": "基础",
      "definition": "半衰期 T 是放射性元素有一半原子核发生衰变所需的时间。每经过一个半衰期，剩余未衰变的核数就减为原来的一半，写成 N=N_0·(1/2)^(t/T)。",
      "meaning": "半衰期是**大量原子核**的统计规律，不是单个核的「倒计时」。它只由核本身决定，和温度、压强、化学状态都无关——因为核外条件根本影响不到核内部。经过 n 个半衰期剩 (1/2)^n，永远不为零，所以「衰变完」只是近似说法。",
      "symbols": {
        "N_0": {
          "desc": "初始时刻未衰变的核数",
          "unit": "1"
        },
        "N": {
          "desc": "经过 t 时间后未衰变的核数",
          "unit": "1"
        },
        "T_half": {
          "desc": "半衰期",
          "unit": "s"
        },
        "t": {
          "desc": "经历的时间",
          "unit": "s"
        },
        "n_half": {
          "desc": "经历的半衰期个数",
          "unit": "1"
        },
        "k_decay": {
          "desc": "衰变常量，表示单位时间内衰变的概率",
          "unit": "s^-1"
        }
      },
      "scenarios": {
