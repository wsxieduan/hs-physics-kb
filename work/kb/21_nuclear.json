{
  "chapter": "第二十一章 · 原子核与核能",
  "order": 21,
  "intro": "这一章把尺度再缩小一档：从原子核内部看物质。核反应之所以能放出巨大能量，根源是质量亏损——反应后总质量比反应前小，少掉的那部分按 E=Δmc² 变成能量。理解这条，再回看裂变与聚变，就不会觉得「能量凭空冒出来」。",
  "points": [
    {
      "id": "nuc-01",
      "title": "原子核的组成与同位素",
      "level": "基础",
      "definition": "原子核由质子和中子组成，二者统称核子。质子数 Z 决定元素种类，中子数 N 决定同位素；质量数 A=Z+N 是核内核子的总数。",
      "meaning": "Z 相当于元素的「身份证」：Z 相同就是同一种元素，化学性质几乎只由 Z 与核外电子决定。N 不同则核的稳定性、放射性可能差别很大，这就是同位素。要注意 A 只表示核子个数，不是原子质量，也不是质子数。",
      "symbols": {
        "Z": {
          "desc": "质子数（也叫核电荷数）",
          "unit": "1"
        },
        "N": {
          "desc": "中子数",
          "unit": "1"
        },
        "A": {
          "desc": "质量数，即核内核子总数",
          "unit": "1"
        },
        "R": {
          "desc": "原子核半径",
          "unit": "m"
        },
        "r_0": {
          "desc": "核半径常量，约 1.2×10⁻¹⁵ m",
          "unit": "m"
        }
      },
      "scenarios": {
        "碳12": {
          "Z": 6,
          "N": 6,
          "A": 12,
          "r_0": 1.2e-15,
          "R": 2.747e-15
        },
        "铀238": {
          "Z": 92,
          "N": 146,
          "A": 238,
          "r_0": 1.2e-15,
          "R": 7.44e-15
        }
      },
      "formulas": [
        {
          "name": "质量数与核电荷数的关系",
          "expr": "A = Z + N",
          "when": "对任何原子核都成立，与核是否稳定无关",
          "checks": [
            {
              "type": "numeric",
              "scenario": "碳12",
              "expr": "Z+N",
              "ref": 12,
              "note": "6 个质子加 6 个中子，核子总数为 12。"
            },
            {
              "type": "numeric",
              "scenario": "铀238",
              "expr": "Z+N",
              "ref": 238,
              "note": "92 个质子加 146 个中子，核子总数为 238。"
            },
            {
              "type": "compare",
              "scenario": "碳12",
              "expr": "Z+N",
              "op": ">",
              "vs": "Z",
              "note": "只要核内有中子（N>0），质量数就必定大于质子数：12 > 6。"
            },
            {
              "type": "consistency",
              "scenario": "碳12",
              "expr": "Z+N",
              "with": "核半径的立方根规律",
              "with_expr": "A",
              "target": "质量数",
              "note": "核半径公式里用的 A，必须等于 Z+N。两条公式在这里对了一次账。"
            }
          ]
        },
        {
          "name": "核半径的立方根规律",
          "expr": "R = r_0*A^(1/3)",
          "when": "把核近似看成实心球；r_0 取 1.2×10⁻¹⁵ m 量级",
          "checks": [
        {
          "type": "numeric",
          "scenario": "碳12",
          "expr": "r_0*A^(1/3)",
          "ref": 2.747e-15,
          "tol": 1e-18,
          "note": "12 的立方根约 2.289，乘 1.2×10⁻¹⁵ 得约 2.75×10⁻¹⁵ m。"
        },
            {
              "type": "numeric",
          "scenario": "铀238",
          "expr": "r_0*A^(1/3)",
          "ref": 7.44e-15,
          "tol": 1e-17,
          "note": "238 的立方根约 6.196，乘 1.2×10⁻¹⁵ 得约 7.44×10⁻¹⁵ m。"
