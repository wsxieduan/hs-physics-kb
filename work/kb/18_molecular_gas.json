              "type": "scan",
              "scenario": "距离小于平衡距离",
              "var": "F_rep",
              "lo": 0,
              "hi": 2e-08
            }
          ]
        },
        {
          "name": "分子力做功与势能变化",
          "expr": "delta_Ep = -W_molecular",
          "when": "只考察分子力这一保守力做功所引起的分子势能变化",
          "checks": [
            {
              "type": "numeric",
