    {
      "id": "mgas-03",
      "title": "温度与温标",
      "level": "基础",
      "definition": "热力学温度 T 与摄氏温度的数值 t_C 相差一个固定零点：T = t_C + T0，其中 T0 近似取 273.15 K。温度间隔的数值在两种温标中相同，所以 Delta_T = T2-T1。气体定律中的温度必须使用热力学温度。",
      "meaning": "温度是大量分子热运动剧烈程度的宏观标志。0 ℃不是热运动停止，绝对零度才是热力学温标的理论下限。摄氏温度可以为负，热力学温度不能低于 0 K；温度变为原来的两倍，必须针对开尔文数值而言，不能直接把摄氏温度数值乘二。",
      "symbols": {
        "T": {
          "desc": "热力学温度",
          "unit": "K"
        },
        "t_C": {
          "desc": "摄氏温度的数值；换算时按与 K 等大的温度间隔处理",
          "unit": "K"
        },
        "T0": {
          "desc": "摄氏零度对应的热力学温度",
          "unit": "K"
        },
        "T1": {
          "desc": "初态热力学温度",
          "unit": "K"
        },
        "T2": {
          "desc": "末态热力学温度",
          "unit": "K"
        },
        "Delta_T": {
          "desc": "温度变化量",
          "unit": "K"
        }
