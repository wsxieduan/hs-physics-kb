    {
      "id": "mgas-02",
      "title": "分子间作用力与分子势能",
      "level": "基础",
      "definition": "分子间同时存在吸引作用和排斥作用，两者都随距离减小而增强，但排斥作用在很近时增长得更快。把沿分子间距离增大的方向取为正，合力可用 F_net = F_rep - F_attr 表示；分子力做功与分子势能变化满足 delta_Ep = -W_molecular。",
      "meaning": "在平衡距离附近，吸引与排斥大小相等，合力为零，分子势能最低。距离小于平衡距离时排斥占优，分子趋向分开；距离略大于平衡距离时吸引占优，分子趋向靠近。合力为零不等于分子间没有作用，而是两种作用恰好抵消。",
      "symbols": {
        "F_net": {
          "desc": "沿分子间距增大方向的合力",
          "unit": "N"
        },
        "F_rep": {
          "desc": "排斥作用的大小",
          "unit": "N"
        },
        "F_attr": {
          "desc": "吸引作用的大小",
          "unit": "N"
        },
        "delta_Ep": {
          "desc": "分子势能的变化量",
          "unit": "J"
        },
        "W_molecular": {
          "desc": "分子力所做的功",
          "unit": "J"
        }
      },
      "scenarios": {
        "距离小于平衡距离": {
          "F_rep": 8e-09,
          "F_attr": 3e-09,
          "F_net": 5e-09
        },
        "分子力做正功": {
          "W_molecular": 2.5e-20,
          "delta_Ep": -2.5e-20
        }
      },
      "formulas": [
        {
          "name": "分子间合力的一维表示",
          "expr": "F_net = F_rep-F_attr",
