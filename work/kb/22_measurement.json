          "checks": [
            {
              "type": "numeric",
              "scenario": "基准",
              "ref": 0.2,
              "note": "0.20×(-0.20)+0.30×0.80=-0.04+0.24=0.20 kg·m/s"
            },
            {
              "type": "consistency",
              "scenario": "基准",
              "expr": "m1*v1_p+m2*v2_p",
              "with": "exp-04|碰后总动量",
              "with_expr": "m1*v1+m2*v2",
              "target": "两条路径的结果",
              "note": "由两组独立光电门记录核对碰前和碰后总动量"
            },
            {
              "type": "scan",
              "scenario": "基准",
              "var": "v1_p",
              "lo": -2,
              "hi": 2,
              "n": 17,
