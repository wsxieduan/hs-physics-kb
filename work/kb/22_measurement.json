{
  "chapter": "第二十二章 · 测量工具、数据处理与实验基础",
  "order": 22,
  "intro": "从纸带和光电门到长度读数，区分计时间隔、仪器分度与测量不确定度。每个算例保留独立验算依据。",
  "points": [
    {
      "id": "exp-01",
      "title": "打点计时器、纸带与计数点",
      "level": "进阶",
      "definition": "打点计时器在纸带上按近似相等时间间隔留下点迹。点迹间距表示该时间内位移，计数点是为了处理数据而从原始点迹中按固定间隔选取的点。",
      "meaning": "电磁打点计时器和电火花计时器的供电方式不同，应按仪器铭牌接线；常见电磁型使用低压交流，常见电火花型使用交流市电，不能混接。交流频率为50 Hz且每周期打一点时，原始点间隔为0.02 s；数点时必须数间隔，六个点只含五个间隔。",
      "symbols": {
        "T_0": {
          "unit": "s",
          "desc": "相邻原始点的时间间隔"
        },
        "f": {
          "unit": "Hz",
          "desc": "实际打点频率"
        },
        "T_c": {
          "unit": "s",
          "desc": "计数点的时间间隔"
        },
        "n": {
          "unit": "1",
          "desc": "两个计数点之间的原始时间间隔个数"
        }
      },
      "scenarios": {
        "基准": {
          "f": 50,
          "n": 5,
          "T_0": 0.02,
          "T_c": 0.1
        }
      },
      "formulas": [
        {
          "name": "相邻打点周期",
          "expr": "T_0 = 1/f",
          "when": "打点计时器实际打点频率为 f；不是隔若干点的计数周期",
          "checks": [
            {
              "type": "numeric",
              "scenario": "基准",
              "ref": 0.02,
              "note": "每秒50次，相邻两点间隔1÷50=0.020 s"
            },
            {
              "type": "scan",
              "scenario": "基准",
              "var": "f",
              "lo": 1,
              "hi": 1000,
              "n": 17,
              "note": "频率必须为正；频率为零不能形成计时记录"
            }
          ]
        },
        {
          "name": "计数周期",
          "expr": "T_c = n*T_0",
          "when": "相邻计数点之间有 n 个打点时间间隔",
          "checks": [
            {
              "type": "numeric",
              "scenario": "基准",
              "ref": 0.1,
              "note": "每隔5个时间间隔选点，5×0.020=0.100 s"
            },
            {
              "type": "consistency",
              "scenario": "基准",
              "expr": "n/f",
              "with": "exp-01|计数周期",
              "with_expr": "n*T_0",
              "target": "两条路径的结果",
              "note": "频率直接计时与逐个时间间隔累加独立核对"
            }
          ]
        }
      ],
      "derivation": [
        "按仪器说明确认型号、供电和打点频率，先通电使打点稳定，再释放或拉动纸带。",
        "选清晰且运动状态合适的一段，标记计数点并写明每组包含几个原始时间间隔。",
        "由每秒打点次数求相邻点间隔，再乘计数间隔个数；测位移时从点中心读数。"
      ],
      "errors": [
        {
          "wrong": "把五个间隔误认为六个间隔",
          "wrong_expr": "T_c = (n+1)/f",
          "why": "数到两端六个点不等于经历六个时间间隔；该错误量纲正确，却使本例计数周期从0.10 s错成0.12 s。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "基准",
            "expr": "(n+1)/f",
            "ref": 0.1
          }
        },
        {
          "wrong": "未核对型号便把所有计时器接到同一种电源",
          "why": "供电要求随型号变化，必须核对铭牌与接线说明；计时公式无法识别接线是否安全、纸带是否卡住。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "50 Hz计时器每隔五个原始时间间隔取一个计数点，求原始点周期和计数周期。",
        "solution": [
          "每秒50个时间间隔，所以原始点周期为0.020 s。",
          "两个计数点相隔五个原始时间间隔，周期为0.100 s。"
        ],
        "answer": "原始点周期0.020 s；计数周期0.100 s。"
      },
      "prereq": [
        "kine-03",
        "kine-04"
      ],
      "next": [
        "exp-02"
      ],
      "tags": [
        "打点计时器",
        "纸带",
        "计数点",
        "时间间隔"
      ]
    },
    {
      "id": "exp-02",
      "title": "纸带瞬时速度、逐差法与运动检验",
      "level": "进阶",
      "definition": "在匀变速直线运动中，一段时间的平均速度等于中间时刻的瞬时速度。纸带数据可由相邻等时位移估计速度，由多段位移逐差估计加速度并检验匀变速假设。",
      "meaning": "先检查相邻位移之差是否在测量误差范围内近似相等，再使用匀变速公式。逐差法利用较长位移减小相对读数误差，但它不会自动消除计时频率错误或纸带阻力。计数周期必须采用计数点间隔，不能一律填原始打点周期；非匀变速时中心平均速度只能作为近似。",
      "symbols": {
        "v2": {
          "unit": "m/s",
          "desc": "第二计数点的瞬时速度"
        },
        "x1": {
          "unit": "m",
          "desc": "第一等时段位移"
        },
        "x2": {
          "unit": "m",
          "desc": "第二等时段位移"
        },
        "x3": {
          "unit": "m",
          "desc": "第三等时段位移"
        },
        "x4": {
          "unit": "m",
          "desc": "第四等时段位移"
        },
        "T_c": {
          "unit": "s",
          "desc": "计数周期"
        },
        "a": {
          "unit": "m/s^2",
          "desc": "加速度"
        },
        "dx": {
          "unit": "m",
          "desc": "相邻等时位移差"
        }
      },
      "scenarios": {
        "基准": {
          "x1": 0.03,
          "x2": 0.05,
          "x3": 0.07,
          "x4": 0.09,
          "T_c": 0.1,
          "a": 2
        }
      },
      "formulas": [
        {
          "name": "中间计数点速度",
          "expr": "v2 = (x2+x3)/(2*T_c)",
          "when": "匀变速直线运动或时间足够短，用该点前后两段位移的平均速度",
          "checks": [
            {
              "type": "numeric",
              "scenario": "基准",
              "ref": 0.6,
              "note": "前后位移0.05+0.07=0.12 m，总时间0.20 s，速度0.60 m/s"
            }
          ]
        },
        {
          "name": "四段逐差加速度",
          "expr": "a = ((x3+x4)-(x1+x2))/(4*T_c^2)",
          "when": "四个连续等时位移；运动应近似匀变速",
          "checks": [
            {
              "type": "numeric",
              "scenario": "基准",
              "ref": 2,
              "note": "后两段与前两段之差0.16-0.08=0.08 m；分母0.04 s²，得到2.0 m/s²"
            },
            {
              "type": "consistency",
              "scenario": "基准",
              "expr": "((x3+x4)-(x1+x2))/(4*T_c^2)",
              "with": "exp-02|四段逐差加速度",
              "with_expr": "((x3+x4)/(2*T_c)-(x1+x2)/(2*T_c))/(2*T_c)",
              "target": "两条路径的结果",
              "note": "逐差法与前后两个中点的速度变化率互证"
            },
            {
              "type": "scan",
              "scenario": "基准",
              "var": "T_c",
              "lo": 0.01,
              "hi": 1,
              "n": 17,
              "note": "周期为正；扫描数值稳定性，不声称固定纸带在不同周期仍是同一次运动"
            }
          ]
        },
        {
          "name": "相邻位移差",
          "expr": "dx = a*T_c^2",
          "when": "相邻等时段内的位移差，带符号",
          "checks": [
            {
              "type": "numeric",
              "scenario": "基准",
              "ref": 0.02,
              "note": "2.0×0.10²=0.020 m"
            }
          ]
        }
      ],
      "derivation": [
        "依次测四段连续等时位移，保留原始记录和长度单位。",
        "第二计数点前后两段总位移除以两个计数周期，得到该点速度。",
        "将后两段之和减前两段之和；两组段中心时刻相差两个周期，因此分母是四倍周期平方。",
        "再比较相邻位移差和速度随时间的直线趋势，检查模型是否合理。"
      ],
      "errors": [
        {
          "wrong": "逐差时把分母写成两倍周期平方",
          "wrong_expr": "a = ((x3+x4)-(x1+x2))/(2*T_c^2)",
          "why": "两组平均速度的时间中心相隔两个计数周期；漏掉这个间隔因子会使加速度加倍，量纲检查无法发现。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "基准",
            "expr": "((x3+x4)-(x1+x2))/(2*T_c^2)",
            "ref": 2
          }
        },
        {
          "wrong": "不检验运动性质就把所有纸带都按匀变速处理",
          "why": "有阻力变化、拉动不均匀或点迹模糊时，位移差未必恒定，应先检查数据而不是用公式强行拟合。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "纸带四段位移依次为3、5、7、9 cm，计数周期0.10 s，求第二点速度和加速度。",
        "solution": [
          "长度换成米；第二点速度为(0.05+0.07)/0.20=0.60 m/s。",
          "逐差分子为0.07+0.09-0.03-0.05=0.08 m，除以0.04 s²得2.0 m/s²。"
        ],
        "answer": "第二点速度0.60 m/s，加速度2.0 m/s²。"
      },
      "prereq": [
        "exp-01",
        "kine-02"
      ],
      "next": [
        "exp-10"
      ],
      "tags": [
        "逐差法",
        "纸带速度",
        "匀变速实验"
      ]
    },
    {
      "id": "exp-03",
      "title": "光电门、遮光条与速度测量",
      "level": "进阶",
      "definition": "光电门记录遮光条经过光束的持续时间。遮光条沿运动方向的有效宽度除以遮光时间，得到遮光期间的平均速度；宽度足够小时可近似门处瞬时速度。",
      "meaning": "测量前应检查条宽、条面与运动方向、门的计时模式和两门间距。条宽越小，瞬时近似通常越好，但计时相对误差可能变大。一个光电门的一次遮光只能给出局部平均速度，不能据此恢复任意完整轨迹；两门求加速度还需匀变速和门处速度近似成立。",
      "symbols": {
        "d": {
          "unit": "m",
          "desc": "遮光条有效宽度"
        },
        "t1": {
          "unit": "s",
          "desc": "第一门遮光时间"
        },
        "t2": {
          "unit": "s",
          "desc": "第二门遮光时间"
        },
        "v1": {
          "unit": "m/s",
          "desc": "第一门近似瞬时速度"
        },
        "v2": {
          "unit": "m/s",
          "desc": "第二门近似瞬时速度"
        },
        "x": {
          "unit": "m",
          "desc": "门间距离"
        },
        "dt": {
          "unit": "s",
          "desc": "两门速度对应时刻之差"
        },
        "a": {
          "unit": "m/s^2",
          "desc": "两门间加速度"
        }
      },
      "scenarios": {
        "基准": {
          "d": 0.01,
          "t1": 0.01,
          "t2": 0.005,
          "v1": 1,
          "v2": 2,
          "x": 0.5,
          "dt": 0.3333333333333333
        }
      },
      "formulas": [
        {
          "name": "遮光平均速度",
          "expr": "v1 = d/t1",
          "when": "遮光条有效宽度沿运动方向；遮光期间平均速度",
          "checks": [
            {
              "type": "numeric",
              "scenario": "基准",
              "ref": 1,
              "note": "宽度0.010 m除以0.010 s，得到1.0 m/s"
            },
            {
              "type": "scan",
              "scenario": "基准",
              "var": "t1",
              "lo": 0.0001,
              "hi": 0.1,
              "n": 17,
              "note": "遮光时间为正；过短时受计时分辨率和条宽误差限制"
            }
          ]
        },
        {
          "name": "第二门平均速度",
          "expr": "v2 = d/t2",
          "when": "同一遮光条通过第二门",
          "checks": [
            {
              "type": "numeric",
              "scenario": "基准",
              "ref": 2,
              "note": "0.010 m除以0.005 s，得到2.0 m/s"
            }
          ]
        },
        {
          "name": "两门加速度估计",
          "expr": "a = (v2^2-v1^2)/(2*x)",
          "when": "两门速度可近似瞬时速度，门距为 x，运动匀变速",
          "checks": [
            {
              "type": "numeric",
              "scenario": "基准",
              "ref": 3,
              "note": "速度平方差4-1=3 m²/s²，门距两倍为1.0 m，得3.0 m/s²"
            },
            {
              "type": "consistency",
              "scenario": "基准",
              "expr": "(v2^2-v1^2)/(2*x)",
              "with": "exp-03|两门加速度估计",
              "with_expr": "(v2-v1)/dt",
              "target": "两条路径的结果",
              "note": "两门速度—位移关系与实测通行时间的速度变化率互证"
            }
          ]
        }
      ],
      "derivation": [
        "用合适仪器测条宽，调节光束，使遮光边缘与运动方向一致。",
        "逐次记录遮光时间并计算局部平均速度；必要时重复测量。",
        "匀变速情况下用两门速度平方差与门距求加速度，也可用两个速度对应时刻之差独立核对。"
      ],
      "errors": [
        {
          "wrong": "把条宽误乘二再计算速度",
          "wrong_expr": "v1 = 2*d/t1",
          "why": "一次遮光对应条宽而非两倍条宽；错误式仍有速度量纲，本例错误值为2.0 m/s而正确值为1.0 m/s。",
          "caught_by": "数值代入",
          "trap_test": {
            "scenario": "基准",
            "expr": "2*d/t1",
            "ref": 1
          }
        },
        {
          "wrong": "把两个遮光持续时间之差当作两门运动时间",
          "why": "两次遮光持续时间不是物体从第一门到第二门的通行时间，使用速度变化率时需记录正确的时刻差。",
          "caught_by": "人工审核"
        }
      ],
      "example": {
        "stem": "条宽1.0 cm，两门遮光时间10 ms和5 ms；门距0.50 m，估计两门速度及加速度。",
        "solution": [
          "两个局部速度为0.01/0.010=1.0 m/s和0.01/0.005=2.0 m/s。",
          "匀变速近似下，加速度为(4-1)/(2×0.50)=3.0 m/s²；独立通行时间1/3 s也给出同值。"
        ],
        "answer": "两门速度1.0、2.0 m/s；加速度约3.0 m/s²。"
      },
      "prereq": [
        "exp-02",
        "kine-01",
        "kine-05"
      ],
      "next": [
        "exp-04"
      ],
      "tags": [
        "光电门",
        "遮光条",
        "瞬时速度测量"
      ]
    },
    {
      "id": "exp-04",
      "title": "气垫导轨、碰撞与动量验证",
      "level": "进阶",
      "definition": "气垫导轨通过气膜减小滑块与导轨的接触摩擦。将导轨调至水平并测量滑块质量和碰撞前后的有向速度，可检验短时间内系统总动量是否近似守恒。",
      "meaning": "先通气并调平，检查单滑块运动是否近似匀速，再用光电门测碰前后速度，选同一个水平正方向。磁性或弹性碰撞器影响动能是否守恒，粘连碰撞仍可守恒动量；气垫不等于没有外力。质量乘位移的比例只能用于初始总动量为零且比较同一时间内的位移等特殊情形，不能替代一般碰撞公式。",
      "symbols": {
        "m1": {
          "unit": "kg",
          "desc": "第一滑块质量"
        },
        "m2": {
          "unit": "kg",
          "desc": "第二滑块质量"
        },
        "v1": {
          "unit": "m/s",
          "desc": "第一滑块碰前有向速度"
        },
        "v2": {
          "unit": "m/s",
          "desc": "第二滑块碰前有向速度"
        },
        "v1_p": {
          "unit": "m/s",
          "desc": "第一滑块碰后有向速度"
        },
        "v2_p": {
          "unit": "m/s",
          "desc": "第二滑块碰后有向速度"
        },
