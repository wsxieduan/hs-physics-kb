          "unit": "J"
        },
        "Q_release": {
          "desc": "高温物体放出的热量大小",
          "unit": "J"
        },
        "Q_absorb": {
          "desc": "低温物体吸收的热量大小",
          "unit": "J"
        }
      },
      "scenarios": {
