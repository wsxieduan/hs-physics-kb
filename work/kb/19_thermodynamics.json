{
  "chapter": "第十九章 · 热力学定律",
  "order": 19,
  "intro": "热力学研究能量如何在做功、传热和物态变化中转移，以及这些过程为什么具有方向性。本章统一采用“外界对系统做功为正”的符号约定：热量 Q 传入系统为正，功 W 由外界对系统做为正，因此热力学第一定律写成 delta_U = Q + W。能量守恒告诉我们数量上不能凭空增减，热力学第二定律则进一步指出实际过程并非任意方向都能发生。",
  "points": [
    {
      "id": "thermo-01",
      "title": "热力学第一定律",
      "level": "基础",
      "definition": "热力学第一定律是能量守恒在热现象中的具体表达。本章规定：传给系统的热量 Q 为正，外界对系统做的功 W 为正，则系统内能的变化量满足 delta_U = Q + W。系统向外界放热时 Q 为负，系统对外界做功时 W 为负。",
      "meaning": "公式最难的不是加法，而是符号。先判断能量沿哪条路径进出系统，再代入正负号：吸热使能量进入系统，取正；外界压缩气体也把能量送入系统，做功取正。相反，气体膨胀推动活塞时能量离开系统，W 取负。内能是状态量，而热量和功是过程量，不能说某个物体“含有多少热量”。",
      "symbols": {
        "delta_U": {
          "desc": "系统内能的变化量，末态内能减初态内能",
          "unit": "J"
        },
        "Q": {
          "desc": "传入系统的热量，吸热为正、放热为负",
          "unit": "J"
        },
        "W": {
          "desc": "外界对系统做的功，外界做正功时为正",
          "unit": "J"
        }
      },
      "scenarios": {
        "吸热膨胀": {
          "Q": 500,
          "W": -200,
          "delta_U": 300
        },
        "绝热压缩": {
          "Q": 0,
          "W": 150,
          "delta_U": 150
        }
      },
      "formulas": [
        {
          "name": "热力学第一定律",
          "expr": "delta_U = Q + W",
          "when": "采用外界对系统做功为正、传入系统的热量为正的约定",
          "checks": [
            {
              "type": "numeric",
              "scenario": "吸热膨胀",
              "expr": "Q + W",
              "ref": 300,
              "note": "系统吸收 500 J，同时对外做功 200 J（所以 W=-200 J），内能增加 500-200=300 J。"
            },
            {
              "type": "numeric",
              "scenario": "绝热压缩",
              "expr": "Q + W",
              "ref": 150,
              "note": "绝热过程 Q=0，外界压缩气体做功 150 J，所以内能增加 150 J。"
            },
            {
              "type": "direction",
              "scenario": "吸热膨胀",
              "var": "Q",
              "lo": 100,
              "hi": 900,
              "expr": "Q + W",
              "expect": "up",
              "note": "做功情况不变时，传入系统的热量越多，内能增加得越多。"
            },
            {
              "type": "scan",
              "scenario": "吸热膨胀",
              "var": "W",
              "lo": -1000,
              "hi": 1000
            }
          ]
        },
        {
          "name": "由内能变化反求外界做功",
          "expr": "W = delta_U - Q",
          "when": "已知内能变化与传热，反求外界对系统做的功",
          "checks": [
            {
              "type": "numeric",
              "scenario": "吸热膨胀",
              "expr": "delta_U - Q",
              "ref": -200,
              "note": "300-500=-200 J，负号说明实际是系统对外界做了 200 J 的功。"
            },
            {
              "type": "numeric",
              "scenario": "绝热压缩",
              "expr": "delta_U - Q",
              "ref": 150,
              "note": "150-0=150 J，表示外界对气体做正功。"
            },
            {
              "type": "direction",
              "scenario": "吸热膨胀",
              "var": "Q",
              "lo": 300,
              "hi": 700,
              "expr": "delta_U - Q",
              "expect": "down",
              "note": "内能增量固定时，吸收热量越多，需要由外界提供的功越少。"
            },
            {
              "type": "consistency",
              "scenario": "吸热膨胀",
              "with": "thermo-01|由内能变化反求外界做功",
